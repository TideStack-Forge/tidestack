{
  "name": "/system-setting/custom-ui-schema",
  "schema": {
    "type": "page",
    "title": "管理自定义页面",
    "pullRefresh": {
      "disabled": true
    },
    "body": [
      {
        "filter": {
          "body": [
            {
              "name": "path.contains",
              "label": "路径",
              "type": "input-text"
            }
          ],
          "actions": [
            {
              "type": "submit",
              "label": "搜索",
              "primary": true
            }
          ]
        },
        "columns": [
          {
            "name": "path",
            "label": "路径"
          },
          {
            "name": "createdAt",
            "label": "创建时间"
          },
          {
            "name": "updatedAt",
            "label": "更新时间"
          },
          {
            "type": "switch",
            "label": "启用",
            "name": "enabled",
            "quickEdit": {
              "mode": "inline",
              "type": "switch",
              "saveImmediately": true
            }
          },
          {
            "type": "operation",
            "label": "操作",
            "buttons": [
              {
                "actionType": "dialog",
                "icon": "fa fa-edit",
                "label": "编辑",
                "dialog": {
                  "size": "full",
                  "bodyClassName": "p-0\tm-0 ",
                  "title": {
                    "tpl": "<strong>编辑页面：${path}</strong>",
                    "type": "tpl"
                  },
                  "url": "/system-setting/custom-ui-schema/edit"
                }
              },
              {
                "actionType": "dialog",
                "label": "代码编辑",
                "icon": "fa fa-code",
                "dialog": {
                  "title": {
                    "type": "tpl",
                    "tpl": "<strong>代码编辑：${path}</strong>"
                  },
                  "size": "full",
                  "bodyClassName": "p-0 m-0",
                  "url": "/system-setting/custom-ui-schema/code"
                }
              },
              {
                "actionType": "ajax",
                "icon": "fa fa-trash",
                "level": "danger",
                "confirmText": "确定要删除「${path}」吗？",
                "label": "删除",
                "api": "delete:/api/sys/custom-ui-schema/${id}"
              }
            ],
            "width": "280px"
          }
        ],
        "type": "crud",
        "model": "table",
        "name": "crud",
        "api": "/api/sys/custom-ui-schema",
        "autoFillHeight": true,
        "quickSaveItemApi": {
          "method": "put",
          "url": "/api/sys/custom-ui-schema/$id",
          "data": {
            "&": "${modified}"
          }
        },
        "headerToolbar": [
          "reload",
          {
            "type": "action",
            "actionType": "dialog",
            "level": "primary",
            "label": "新增",
            "icon": "fa fa-plus",
            "align": "right",
            "dialog": {
              "title": "新建自定义页面",
              "size": "full",
              "bodyClassName": "p-0 m-0",
              "url": "/system-setting/custom-ui-schema/add",
              "data": {}
            }
          }
        ]
      }
    ]
  }
}
