{
  "name": "/document-management/library-settings",
  "schema": {
    "type": "form",
    "initApi": {
      "method": "get",
      "url": "/api/document-libraries/${id}"
    },
    "api": {
      "method": "put",
      "url": "/api/document-libraries/${id}/info",
      "messages": {
        "success": "文档库信息更新成功"
      }
    },
    "body": [
      {
        "type": "input-text",
        "name": "displayName",
        "label": "显示名称",
        "required": true
      },
      {
        "type": "textarea",
        "name": "description",
        "label": "描述"
      }
    ]
  }
}
