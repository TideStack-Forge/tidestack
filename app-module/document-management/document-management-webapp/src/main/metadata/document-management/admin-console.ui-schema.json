{
  "name": "/document-management/admin-console",
  "schema": {
    "type": "page",
    "title": "文档库管理控制台",
    "pullRefresh": {
      "disabled": true
    },
    "body": [
      {
        "type": "crud",
        "api": "/api/document-libraries/admin",
        "syncLocation": false,
        "headerToolbar": [
          "reload"
        ],
        "columns": [
          {
            "name": "id",
            "label": "ID",
            "width": 80
          },
          {
            "name": "name",
            "label": "名称"
          },
          {
            "name": "displayName",
            "label": "显示名称"
          },
          {
            "name": "ownerDisplayName",
            "label": "所有者"
          },
          {
            "name": "createdAt",
            "label": "创建时间",
            "type": "datetime"
          },
          {
            "type": "operation",
            "label": "操作",
            "width": "320px",
            "buttons": [
              {
                "type": "button",
                "label": "${disabled ? '启用' : '禁用'}",
                "actionType": "ajax",
                "visibleOn": "${!deleted}",
                "api": {
                  "method": "post",
                  "url": "/api/document-libraries/admin/${id}/${disabled ? 'enable' : 'disable'}",
                  "messages": {
                    "success": "${disabled ? '启用成功' : '禁用成功'}"
                  }
                }
              },
              {
                "type": "button",
                "label": "${locked ? '解锁' : '锁定'}",
                "actionType": "ajax",
                "visibleOn": "${!deleted}",
                "api": {
                  "method": "post",
                  "url": "/api/document-libraries/admin/${id}/${locked ? 'unlock' : 'lock'}",
                  "messages": {
                    "success": "${locked ? '解锁成功' : '锁定成功'}"
                  }
                }
              },
              {
                "type": "button",
                "label": "${deleted ? '恢复' : '删除'}",
                "level": "${deleted ? 'info' : 'danger'}",
                "actionType": "ajax",
                "confirmText": "${deleted ? '确定要恢复该文档库吗？' : '确定要软删除该文档库吗？'}",
                "api": {
                  "method": "post",
                  "url": "/api/document-libraries/admin/${id}${deleted ? '/restore' : '/soft-delete'}",
                  "messages": {
                    "success": "${deleted ? '恢复成功' : '删除成功'}"
                  }
                }
              },
              {
                "type": "button",
                "label": "转移所有权",
                "actionType": "dialog",
                "visibleOn": "${!deleted}",
                "dialog": {
                  "title": "转移所有权",
                  "size": "md",
                  "url": "/document-management/transfer-ownership"
                }
              },
              {
                "type": "button",
                "label": "彻底删除",
                "level": "danger",
                "actionType": "ajax",
                "visibleOn": "${deleted}",
                "confirmText": "确定要彻底删除该文档库吗？此操作不可恢复！",
                "api": {
                  "method": "delete",
                  "url": "/api/document-libraries/admin/${id}",
                  "messages": {
                    "success": "彻底删除成功"
                  }
                }
              }
            ]
          }
        ],
        "footerToolbar": [
          "statistics",
          "pagination"
        ]
      }
    ]
  }
}
