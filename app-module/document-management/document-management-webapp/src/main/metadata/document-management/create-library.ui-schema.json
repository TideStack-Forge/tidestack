{
  "name": "/document-management/create-library",
  "schema": {
    "type": "form",
    "wrapWithPanel": false,
    "api": {
      "method": "post",
      "url": "/api/document-libraries",
      "messages": {
        "success": "文档库创建成功"
      }
    },
    "body": [
      {
        "type": "input-text",
        "name": "name",
        "label": "名称",
        "required": true,
        "placeholder": "文档库唯一标识，只能包含字母、数字、下划线"
      },
      {
        "type": "input-text",
        "name": "displayName",
        "label": "显示名称",
        "required": true
      },
      {
        "type": "textarea",
        "name": "description",
        "label": "描述"
      }
    ]
  }
}
