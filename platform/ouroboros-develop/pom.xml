<project>
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ouroboros</groupId>
        <artifactId>ouroboros-root</artifactId>
        <version>2.0.0-rc.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ouroboros-develop</artifactId>
    <packaging>jar</packaging>
    <name>Ouroboros Develop</name>

    <properties>
        <jacoco.skip>true</jacoco.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency><groupId>com.ouroboros</groupId><artifactId>ouroboros-storage-filesystem</artifactId></dependency>
        <dependency><groupId>com.ouroboros</groupId><artifactId>ouroboros-storage-s3</artifactId></dependency>
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-helper-runtime</artifactId>
            <version>${ouroboros.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-logicflow-debug-helper</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
<dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 启用Java 21 编译基线 -->

        <!-- spring boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- mysql数据库驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>

        <!-- druid starter -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>

        <!-- 数据库迁移工具 -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- ouroboros能力聚合 -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-ability-all-runtime</artifactId>
        </dependency>

        <!-- 审批流运行时 -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-approval-workflow-runtime</artifactId>
        </dependency>

        <!-- 审批流业务模型表单适配 -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-approval-workflow-business-model-form</artifactId>
        </dependency>

        <!-- needed because pom aggregation does not enter the local runtime classpath -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-approval-workflow-dev</artifactId>
        </dependency>

        <!-- 开发管理包 -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-module-all</artifactId>
            <type>pom</type>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-app-module-model-dev</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-app-management</artifactId>
        </dependency>

        <!-- 开发助手相关 -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-helper-dev-metadata-provider</artifactId>
            <version>${ouroboros.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-approval-workflow-dynamic-form</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>dynamic-form-runtime</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--重写包含依赖，包含不存在的依赖，jar里没有pom里的依赖 -->
                    <includes>
                        <include>
                            <groupId>null</groupId>
                            <artifactId>null</artifactId>
                        </include>
                    </includes>
                    <layout>ZIP</layout>
                    <layers>
                        <enabled>false</enabled>
                    </layers>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Java 21 compile baseline -->
                    <release>21</release>
                    <source>21</source>
                    <target>21</target>
                    <!-- The following setting can be avoided on Java 14 and higher -->
                    <compilerArgs>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application.yml</include>
                    <include>logback-spring.xml</include>
                    <include>META-INF/**</include>
                </includes>
            </resource>
        </resources>
    </build>

    <profiles>
        <profile>
            <id>debug</id>
            <activation>
                <property>
                    <name>spring.profiles.active</name>
                    <value>debug</value>
                </property>
            </activation>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <filtering>true</filtering>
                        <includes>
                            <include>application.yml</include>
                            <include>application-debug.yml</include>
                            <include>logback-spring.xml</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
        <!-- 防止在IDEA中build失败-->
        <profile>
            <id>intellij-idea-only</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- JDK21 -->
        <profile>
            <id>jdk21</id>
            <properties>
                <maven.compiler.source>21</maven.compiler.source>
                <maven.compiler.target>21</maven.compiler.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                            <source>21</source>
                            <target>21</target>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
