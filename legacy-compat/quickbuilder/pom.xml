<project>
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>parent</artifactId>
        <groupId>com.xinpai</groupId>
        <version>1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>quickbuilder-ouroboros-spring-boot-starter</artifactId>
    <packaging>jar</packaging>
    <version>1.0.0.M2-SNAPSHOT</version>
    <name>Quick-Builder Ouroboros Spring boot starter</name>

    <properties>
        <ouroboros.legacy.groupId>com.xinpai.ouroboros</ouroboros.legacy.groupId>
        <ouroboros.legacy.version>${project.version}</ouroboros.legacy.version>
        <ouroboros.current.groupId>com.ouroboros</ouroboros.current.groupId>
        <ouroboros.current.version>2.0.0-rc.1-SNAPSHOT</ouroboros.current.version>
    </properties>

    <dependencies>
        <!-- 测试相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>3.0.14</version>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>5.1.12.RELEASE</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.xinpai.qb</groupId>
            <artifactId>qb-runner-single</artifactId>
            <version>1.1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <version>4.22.0</version>
        </dependency>

        <!-- 数据模型 -->
        <dependency>
            <groupId>${ouroboros.legacy.groupId}</groupId>
            <artifactId>ouroboros-data-spring-boot-starter</artifactId>
            <version>${ouroboros.legacy.version}</version>
        </dependency>

        <dependency>
            <groupId>${ouroboros.legacy.groupId}</groupId>
            <artifactId>ouroboros-data-sql-legacy-spring-boot-starter</artifactId>
            <version>${ouroboros.legacy.version}</version>
        </dependency>

        <dependency>
            <groupId>${ouroboros.legacy.groupId}</groupId>
            <artifactId>ouroboros-data-typed-spring-boot-starter</artifactId>
            <version>${ouroboros.legacy.version}</version>
        </dependency>

        <!-- UI模型 -->
        <dependency>
            <groupId>${ouroboros.legacy.groupId}</groupId>
            <artifactId>ouroboros-ui-model-runtime</artifactId>
            <version>${ouroboros.legacy.version}</version>
        </dependency>

        <dependency>
            <groupId>${ouroboros.current.groupId}</groupId>
            <artifactId>ouroboros-ui-model-schema-runtime</artifactId>
            <version>${ouroboros.current.version}</version>
        </dependency>

        <!-- 菜单模型 -->
        <dependency>
            <groupId>${ouroboros.legacy.groupId}</groupId>
            <artifactId>ouroboros-menu-model-core</artifactId>
            <version>${ouroboros.legacy.version}</version>
        </dependency>

        <!-- 动态表单 -->
        <dependency>
            <groupId>${ouroboros.current.groupId}</groupId>
            <artifactId>dynamic-form-runtime</artifactId>
            <version>${ouroboros.current.version}</version>
        </dependency>

        <!-- 字段类型 -->
        <dependency>
            <groupId>${ouroboros.current.groupId}</groupId>
            <artifactId>ouroboros-field-type-runtime</artifactId>
            <version>${ouroboros.current.version}</version>
        </dependency>

        <dependency>
            <groupId>${ouroboros.current.groupId}</groupId>
            <artifactId>ouroboros-field-type-default-types</artifactId>
            <version>${ouroboros.current.version}</version>
        </dependency>

        <dependency>
            <groupId>com.querydsl</groupId>
            <artifactId>querydsl-core</artifactId>
            <version>5.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>2.1.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>addSources</goal>
                            <goal>addTestSources</goal>
                            <goal>compile</goal>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sources>
                        <source>
                            <directory>${project.basedir}/src/main/java</directory>
                            <includes>
                                <include>**/*.groovy</include>
                            </includes>
                        </source>
                    </sources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
