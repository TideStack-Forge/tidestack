{
  "name": "/dev/{appName}/business-log-template/edit",
  "schema": {
    "type": "form",
    "title": false,
    "wrapWithPanel": false,
    "initApi": {
      "method": "get",
      "url": "/api/dev/${appName}/business-log-template/${name}"
    },
    "api": {
      "method": "put",
      "url": "/api/dev/${appName}/business-log-template/${name}"
    },
    "reload": "businessLogTemplateDevList",
    "body": [
      {
        "label": "名称",
        "type": "input-text",
        "name": "name",
        "required": true,
        "static": true
      },
      {
        "label": "请求方法",
        "type": "select",
        "name": "httpMethod",
        "required": true,
        "options": [
          {
            "label": "GET",
            "value": "GET"
          },
          {
            "label": "POST",
            "value": "POST"
          },
          {
            "label": "PUT",
            "value": "PUT"
          },
          {
            "label": "PATCH",
            "value": "PATCH"
          },
          {
            "label": "DELETE",
            "value": "DELETE"
          }
        ]
      },
      {
        "label": "URL",
        "type": "input-text",
        "name": "url",
        "required": true
      },
      {
        "label": "模块名",
        "type": "input-text",
        "name": "moduleName",
        "required": true
      },
      {
        "label": "操作名",
        "type": "input-text",
        "name": "operation",
        "required": true
      },
      {
        "label": "级别",
        "type": "select",
        "name": "level",
        "required": true,
        "options": [
          {
            "label": "一般",
            "value": "INFO"
          },
          {
            "label": "警告",
            "value": "WARN"
          },
          {
            "label": "危险",
            "value": "DANGER"
          }
        ]
      },
      {
        "label": "业务键字段",
        "type": "input-text",
        "name": "businessKeyName"
      },
      {
        "label": "摘要模板",
        "type": "script-editor",
        "name": "summaryTemplate",
        "minRows": 3,
        "language": "freemarker",
        "codeResourceType": "business-log-template",
        "codeSite": "business-log.summary",
        "codePointer": "/summaryTemplate",
        "intelligenceApi": "/api/dev/${appName}/code-intelligence/context"
      },
      {
        "type": "input-array",
        "name": "sensitiveFields",
        "label": "脱敏字段",
        "value": [],
        "addButtonText": "新增脱敏字段",
        "items": [
          {
            "type": "input-text",
            "placeholder": "字段名"
          }
        ]
      },
      {
        "name": "shouldSaveResponseBody",
        "type": "switch",
        "label": "保存响应体",
        "value": false
      }
    ],
    "actions": [
      {
        "type": "button",
        "actionType": "cancel",
        "label": "取消"
      },
      {
        "type": "submit",
        "label": "保存",
        "level": "primary"
      }
    ]
  }
}
