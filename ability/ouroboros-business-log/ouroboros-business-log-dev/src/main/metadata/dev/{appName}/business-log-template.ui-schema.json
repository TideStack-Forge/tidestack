{
  "name": "/dev/{appName}/business-log-template",
  "schema": {
    "type": "crud",
    "api": {
      "method": "get",
      "url": "/api/dev/${appName}/business-log-template"
    },
    "filter": {
      "title": "",
      "body": [
        {
          "type": "input-text",
          "name": "keyword",
          "label": "关键字",
          "placeholder": "搜索名称、模板键、模块名、操作名",
          "clearable": true
        },
        {
          "type": "select",
          "name": "httpMethod",
          "label": "请求方法",
          "clearable": true,
          "options": [
            {
              "label": "GET",
              "value": "GET"
            },
            {
              "label": "POST",
              "value": "POST"
            },
            {
              "label": "PUT",
              "value": "PUT"
            },
            {
              "label": "PATCH",
              "value": "PATCH"
            },
            {
              "label": "DELETE",
              "value": "DELETE"
            }
          ]
        },
        {
          "type": "input-text",
          "name": "moduleName",
          "label": "模块名",
          "clearable": true
        }
      ]
    },
    "columns": [
      {
        "type": "text",
        "label": "名称",
        "name": "name"
      },
      {
        "type": "text",
        "label": "请求方法",
        "name": "httpMethod"
      },
      {
        "type": "text",
        "label": "URL",
        "name": "url"
      },
      {
        "type": "text",
        "label": "模块名",
        "name": "moduleName"
      },
      {
        "type": "text",
        "label": "操作名",
        "name": "operation"
      },
      {
        "type": "mapping",
        "label": "级别",
        "name": "level",
        "map": {
          "INFO": "一般",
          "WARN": "警告",
          "DANGER": "危险"
        }
      },
      {
        "type": "operation",
        "label": "操作",
        "buttons": [
          {
            "type": "button",
            "actionType": "dialog",
            "dialog": {
              "type": "dialog",
              "size": "lg",
              "title": "${operation || name} - 业务日志模板详情",
              "url": "/dev/${appName}/business-log-template/detail",
              "actions": []
            },
            "icon": "fa fa-eye"
          },
          {
            "type": "button",
            "icon": "fa fa-pencil",
            "actionType": "dialog",
            "dialog": {
              "type": "dialog",
              "size": "lg",
              "title": "编辑 ${name}",
              "url": "/dev/${appName}/business-log-template/edit"
            },
            "reload": "businessLogTemplateDevList"
          },
          {
            "type": "button",
            "actionType": "ajax",
            "icon": "fa fa-times text-danger",
            "confirmText": "确认要删除 ${name} 吗？",
            "api": {
              "method": "delete",
              "url": "/api/dev/${appName}/business-log-template/${name}"
            },
            "reload": "businessLogTemplateDevList"
          }
        ]
      }
    ],
    "bulkActions": [],
    "perPageAvailable": [
      10
    ],
    "headerToolbar": [
      "bulkActions",
      {
        "label": "刷新",
        "icon": "fa fa-repeat",
        "type": "button",
        "actionType": "reload"
      },
      {
        "type": "button",
        "label": "新增",
        "actionType": "dialog",
        "level": "primary",
        "align": "right",
        "dialog": {
          "size": "lg",
          "url": "/dev/${appName}/business-log-template/add",
          "type": "dialog",
          "showCloseButton": true,
          "closeOnEsc": false,
          "showErrorMsg": true,
          "showLoading": true,
          "title": "新增业务日志模板"
        },
        "reload": "businessLogTemplateDevList"
      }
    ],
    "alwaysShowPagination": true,
    "mode": "table",
    "loadDataOnce": true,
    "id": "businessLogTemplateDevList"
  }
}
