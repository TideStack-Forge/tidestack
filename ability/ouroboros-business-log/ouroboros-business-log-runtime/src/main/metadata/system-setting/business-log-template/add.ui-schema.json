{
  "name": "/system-setting/business-log-template/add",
  "schema": {
    "type": "form",
    "title": false,
    "wrapWithPanel": false,
    "mode": "horizontal",
    "api": {
      "method": "post",
      "url": "/api/sys/business-log-template"
    },
    "reload": "businessLogTemplateList",
    "body": [
      {
        "type": "select",
        "name": "apiModel",
        "label": "API 模型",
        "searchable": true,
        "clearable": true,
        "source": {
          "method": "get",
          "url": "/api/dev/${appName}/metadata/webapi"
        },
        "labelField": "label",
        "valueField": "value",
        "onEvent": {
          "change": {
            "actions": [
              {
                "actionType": "setValue",
                "componentId": "httpMethodField",
                "args": {
                  "value": "${event.data.selectedItems.method}"
                }
              },
              {
                "actionType": "setValue",
                "componentId": "urlField",
                "args": {
                  "value": "${event.data.selectedItems.path}"
                }
              }
            ]
          }
        }
      },
      {
        "type": "select",
        "id": "httpMethodField",
        "name": "httpMethod",
        "label": "请求方法",
        "required": true,
        "options": [
          {
            "label": "GET",
            "value": "GET"
          },
          {
            "label": "POST",
            "value": "POST"
          },
          {
            "label": "PUT",
            "value": "PUT"
          },
          {
            "label": "PATCH",
            "value": "PATCH"
          },
          {
            "label": "DELETE",
            "value": "DELETE"
          }
        ]
      },
      {
        "type": "input-text",
        "id": "urlField",
        "name": "url",
        "label": "URL",
        "required": true,
        "placeholder": "请输入请求 URL"
      },
      {
        "type": "input-text",
        "name": "moduleName",
        "label": "模块名",
        "required": true,
        "placeholder": "请输入模块名"
      },
      {
        "type": "input-text",
        "name": "operation",
        "label": "操作名",
        "required": true,
        "placeholder": "请输入操作名"
      },
      {
        "type": "select",
        "name": "level",
        "label": "级别",
        "required": true,
        "options": [
          {
            "label": "一般",
            "value": "INFO"
          },
          {
            "label": "警告",
            "value": "WARN"
          },
          {
            "label": "危险",
            "value": "DANGER"
          }
        ]
      },
      {
        "type": "input-text",
        "name": "businessKeyName",
        "label": "业务键字段",
        "placeholder": "例如 id"
      },
      {
        "type": "textarea",
        "name": "summaryTemplate",
        "label": "摘要模板",
        "minRows": 3,
        "placeholder": "请输入日志摘要模板"
      },
      {
        "type": "input-array",
        "name": "sensitiveFields",
        "label": "脱敏字段",
        "value": [],
        "addButtonText": "新增脱敏字段",
        "items": [
          {
            "type": "input-text",
            "placeholder": "字段名"
          }
        ]
      },
      {
        "type": "switch",
        "name": "shouldSaveResponseBody",
        "label": "保存响应体",
        "value": false
      }
    ],
    "actions": [
      {
        "type": "button",
        "actionType": "cancel",
        "label": "取消"
      },
      {
        "type": "submit",
        "label": "提交",
        "level": "primary"
      }
    ]
  }
}
