<project>
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ouroboros</groupId>
        <artifactId>ouroboros-approval-workflow-external-integration</artifactId>
        <version>2.0.0-rc.1-SNAPSHOT</version>
    </parent>

    <artifactId>ouroboros-approval-workflow-external-integration-runtime</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency><groupId>com.ouroboros</groupId><artifactId>ouroboros-enterprise-connector-runtime</artifactId></dependency>
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-data-typed-core</artifactId>
        </dependency>
        <!-- 外部对接合同 -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-approval-workflow-external-integration-core</artifactId>
        </dependency>

        <!-- 常用功能包（异常体系、Spring 装配基础） -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>common-all</artifactId>
            <type>pom</type>
        </dependency>

        <!-- 事务 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- 动态数据模型与模型服务基类（映射持久化） -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-data-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>common-service</artifactId>
        </dependency>

        <!-- 统一配置系统（外部连接配置读取） -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-configuration-core</artifactId>
        </dependency>

        <!-- RBAC（映射管理权限点，Phase 3 最小落地） -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-web-security-annotation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-web-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-web-security-runtime</artifactId>
        </dependency>

        <!-- Legacy SSO model is needed only by runtime migration integration tests. -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-web-security-rbac-manage</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 审批流核心与管理（路由门面、flowKey 校验） -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-approval-workflow-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-approval-workflow-manage</artifactId>
        </dependency>

        <!-- 业务 callback listener 的持久化 outbox 集成测试依赖。 -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-approval-workflow-runtime</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Cross-module legacy fact receiver integration uses the production business projection. -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-business-model-runtime</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 显式 MySQL 集成测试依赖；仅由 mysql-integration profile 的 Failsafe 执行。 -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-data-sql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 错误码元数据模型（测试对照用） -->
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-error-code-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Java 21 编译基线 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>package-test-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 需要显式提供 MySQL 连接参数，不进入普通单元测试。 -->
        <profile>
            <id>mysql-integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>mysql-integration-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*MySqlIT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <ouroboros.mysql.url>${ouroboros.mysql.url}</ouroboros.mysql.url>
                                <ouroboros.mysql.user>${ouroboros.mysql.user}</ouroboros.mysql.user>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 防止在IDEA中build失败-->
        <profile>
            <id>intellij-idea-only</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- JDK21 -->
        <profile>
            <id>jdk21</id>
            <properties>
                <maven.compiler.source>21</maven.compiler.source>
                <maven.compiler.target>21</maven.compiler.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                            <source>21</source>
                            <target>21</target>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
