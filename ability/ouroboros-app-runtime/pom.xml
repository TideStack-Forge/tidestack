<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ouroboros</groupId>
        <artifactId>ouroboros-root</artifactId>
        <version>2.0.0-rc.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ouroboros-app-runtime</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-statistics-reporting-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>common-service</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-util</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>common-metadata</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>common-error-code</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-error-code-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-i18n-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- 测试相关 -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 启用Java 21 编译基线 -->

        <!-- Groovy 支持 -->
        <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy-all</artifactId>
            <type>pom</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-configuration-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-configuration-runtime</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-resource-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-resource-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-web-security-annotation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-ui-model-microweb</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-web-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-organization-structure-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-notification-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-notification-channel-all</artifactId>
            <type>pom</type>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-business-log-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-message-queue-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>common-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>common-lock</artifactId>
        </dependency>

        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Java 21 compile baseline -->
                    <release>21</release>
                    <source>21</source>
                    <target>21</target>
                    <!-- The following setting can be avoided on Java 14 and higher -->
                    <compilerArgs>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 防止在IDEA中build失败-->
        <profile>
            <id>intellij-idea-only</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- JDK21 -->
        <profile>
            <id>jdk21</id>
            <properties>
                <maven.compiler.source>21</maven.compiler.source>
                <maven.compiler.target>21</maven.compiler.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                            <source>21</source>
                            <target>21</target>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
