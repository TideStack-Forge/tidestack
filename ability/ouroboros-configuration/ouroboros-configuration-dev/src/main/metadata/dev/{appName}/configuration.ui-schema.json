{
  "name": "/dev/{appName}/configuration",
  "schema": {
    "type": "page",
    "body": [
      {
        "type": "crud",
        "api": {
          "method": "get",
          "url": "/api/dev/${appName}/configuration"
        },
        "columns": [
          {
            "label": "配置键",
            "name": "key"
          },
          {
            "label": "配置名",
            "name": "label"
          },
          {
            "type": "text",
            "label": "范围",
            "name": "scope",
            "tpl": "${scope=='frontend' ? '前端' : '后端'}"
          },
          {
            "type": "tpl",
            "label": "是否允许修改",
            "name": "modifiable",
            "tpl": "${modifiable ? '允许' : '不允许'}"
          },
          {
            "type": "tpl",
            "label": "是否允许为空",
            "name": "nullable",
            "tpl": "${nullable ? '允许' : '不允许'}"
          },
          {
            "name": "valueType",
            "type": "text",
            "label": "值类型"
          },
          {
            "type": "text",
            "label": "默认值",
            "name": "defaultValue"
          },
          {
            "type": "text",
            "label": "描述",
            "name": "description"
          },
          {
            "type": "text",
            "label": "是否过时",
            "name": "obsolete",
            "tpl": "${obsolete ? '过时' : '不过时'}"
          },
          {
            "type": "operation",
            "label": "操作",
            "buttons": [
              {
                "type": "button",
                "actionType": "dialog",
                "dialog": {
                  "type": "dialog",
                  "title": "${key} - 配置详情",
                  "url": "/dev/${appName}/configuration/detail",
                  "actions": []
                },
                "icon": "fa fa-eye"
              },
              {
                "type": "button",
                "icon": "fa fa-pencil",
                "actionType": "dialog",
                "dialog": {
                  "type": "dialog",
                  "title": "编辑${key} - 配置",
                  "url": "/dev/${appName}/configuration/edit"
                }
              },
              {
                "type": "button",
                "actionType": "ajax",
                "icon": "fa fa-times text-danger",
                "confirmText": "确认要删除${key}吗？",
                "api": {
                  "method": "delete",
                  "url": "/api/dev/${appName}/configuration/${key}"
                }
              }
            ]
          }
        ],
        "bulkActions": [],
        "perPageAvailable": [
          10,
          20,
          50
        ],
        "footerToolbar": [
          "statistics",
          "switch-per-page",
          "pagination"
        ],
        "headerToolbar": [
          "bulkActions",
          {
            "label": "刷新",
            "icon": "fa fa-repeat",
            "type": "button",
            "actionType": "reload"
          },
          {
            "type": "button",
            "label": "新增",
            "actionType": "dialog",
            "level": "primary",
            "align": "right",
            "dialog": {
              "type": "dialog",
              "url": "/dev/${appName}/configuration/add",
              "showCloseButton": true,
              "closeOnEsc": false,
              "showErrorMsg": true,
              "showLoading": true,
              "title": "新增配置"
            }
          }
        ],
        "mode": "table",
        "syncLocation": false,
        "loadDataOnce": true
      }
    ]
  }
}
