{
  "name": "/dev/{appName}/rpc-auth/list",
  "schema": {
    "type": "crud",
    "api": {
      "method": "get",
      "url": "/api/dev/${appName}/rpc-auth"
    },
    "headerToolbar": [
      {
        "type": "reload",
        "label": "刷新",
        "icon": "fa fa-refresh"
      },
      {
        "type": "button",
        "label": "新增",
        "actionType": "dialog",
        "level": "primary",
        "align": "right",
        "dialog": {
          "type": "dialog",
          "title": "新建身份认证",
          "size": "lg",
          "url": "/dev/${appName}/rpc-auth/add",
          "showCloseButton": true,
          "closeOnEsc": false,
          "showErrorMsg": true,
          "showLoading": true
        }
      }
    ],
    "columns": [
      {
        "name": "name",
        "label": "名称",
        "type": "text"
      },
      {
        "name": "title",
        "label": "标题",
        "type": "text"
      },
      {
        "type": "mapping",
        "label": "类型",
        "name": "type",
        "map": {
          "AccessToken": "访问令牌",
          "PlainCredentials": "简单明文凭据",
          "HttpBasic": "HTTP 基本认证",
          "HmacSignature": "AK/SK HMAC 签名"
        }
      },
      {
        "label": "是否启用",
        "name": "isEnabled",
        "type": "switch",
        "onText": "启用",
        "offText": "禁用",
        "static": true
      },
      {
        "type": "operation",
        "label": "操作",
        "buttons": [
          {
            "type": "button",
            "actionType": "dialog",
            "dialog": {
              "type": "dialog",
              "size": "lg",
              "title": "查看 ${title}（${name}） 认证",
              "url": "/dev/${appName}/rpc-auth/detail",
              "actions": []
            },
            "icon": "fa fa-eye"
          },
          {
            "type": "button",
            "icon": "fa fa-pencil",
            "actionType": "dialog",
            "dialog": {
              "type": "dialog",
              "size": "lg",
              "title": "编辑 ${title}（${name}） 认证",
              "url": "/dev/${appName}/rpc-auth/edit"
            }
          },
          {
            "type": "button",
            "actionType": "ajax",
            "icon": "fa fa-times text-danger",
            "confirmText": "确认要删除 ${title}（${name}）吗？",
            "api": {
              "method": "delete",
              "url": "/api/dev/${appName}/rpc-auth/${name}"
            }
          }
        ]
      }
    ],
    "alwaysShowPagination": true,
    "footerToolbar": [
      "statistics",
      "pagination",
      "switch-per-page"
    ],
    "perPageAvailable": [
      10,
      20,
      50
    ],
    "loadDataOnce": true,
    "mode": "table"
  }
}
