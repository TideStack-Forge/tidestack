{
  "name": "/dev/{appName}/rpc-auth/type/PlainCredentials",
  "schema": {
    "type": "fieldSet",
    "title": "简单明文凭据配置",
    "visibleOn": "${type === 'PlainCredentials'}",
    "collapsable": true,
    "body": [
      {
        "type": "combo",
        "name": "plainCredentials.credentials",
        "label": "请求参数",
        "multiple": true,
        "multiLine": true,
        "items": [
          {
            "type": "input-group",
            "name": "request-parameters",
            "body": [
              {
                "name": "in",
                "type": "script-editor",
                "required": true,
                "value": "query",
                "placeholder": "凭据位置",
                "language": "rpc-template",
                "codeResourceType": "rpc-auth",
                "intelligenceApi": "/api/dev/${appName}/code-intelligence/context",
                "codeSite": "rpc-auth.plainCredentials.credentials.*.in",
                "codePointer": "/plainCredentials/credentials/*/in",
                "description": "支持 #{配置键} 引用配置值。"
              },
              {
                "name": "name",
                "placeholder": "凭据名称",
                "type": "script-editor",
                "required": true,
                "language": "rpc-template",
                "codeResourceType": "rpc-auth",
                "intelligenceApi": "/api/dev/${appName}/code-intelligence/context",
                "codeSite": "rpc-auth.plainCredentials.credentials.*.name",
                "codePointer": "/plainCredentials/credentials/*/name",
                "description": "支持 #{配置键} 引用配置值。"
              },
              {
                "name": "value",
                "placeholder": "凭据值，建议通过 #{配置项} 的方式引用配置项",
                "type": "script-editor",
                "required": true,
                "language": "rpc-template",
                "codeResourceType": "rpc-auth",
                "intelligenceApi": "/api/dev/${appName}/code-intelligence/context",
                "codeSite": "rpc-auth.plainCredentials.credentials.*.value",
                "codePointer": "/plainCredentials/credentials/*/value",
                "description": "支持 #{配置键} 引用配置值。"
              }
            ]
          }
        ]
      }
    ]
  }
}
