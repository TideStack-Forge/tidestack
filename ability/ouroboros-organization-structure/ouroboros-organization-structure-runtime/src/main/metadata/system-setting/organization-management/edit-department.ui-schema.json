{
  "name": "/system-setting/organization-management/edit-department",
  "schema": {
    "type": "form",
    "title": "",
    "mode": "horizontal",
    "initApi": {
      "url": "/api/organization/departments/${id}",
      "method": "get"
    },
    "api": {
      "url": "/api/organization/departments/${id}",
      "method": "put"
    },
    "body": [
      {
        "name": "name",
        "type": "input-text",
        "label": "部门名称",
        "required": true,
        "placeholder": "请输入部门名称",
        "clearable": true,
        "validations": {
          "maxLength": 100,
          "minLength": 1
        }
      },
      {
        "name": "adminLevel",
        "type": "select",
        "label": "行政级别",
        "clearable": true,
        "searchable": true,
        "source": {
          "method": "get",
          "url": "/api/admin-level?scope=DEPT&enabled=true"
        },
        "labelField": "name",
        "valueField": "code"
      },
      {
        "name": "description",
        "type": "textarea",
        "label": "部门描述",
        "placeholder": "请输入部门描述",
        "clearable": true,
        "validations": {
          "maxLength": 500
        }
      }
    ],
    "wrapWithPanel": false
  }
}
