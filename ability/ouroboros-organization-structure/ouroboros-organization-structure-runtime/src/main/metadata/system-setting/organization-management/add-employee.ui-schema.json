{
  "name": "/system-setting/organization-management/add-employee",
  "schema": {
    "type": "form",
    "title": "",
    "mode": "horizontal",
    "api": {
      "url": "/api/organization/employees",
      "method": "post"
    },
    "reload": "employeeList",
    "body": [
      {
        "type": "hidden",
        "name": "departmentId",
        "value": "${departmentId}"
      },
      {
        "label": "姓名",
        "type": "input-text",
        "name": "name",
        "required": true,
        "placeholder": "请输入姓名",
        "clearable": true,
        "validations": {
          "maxLength": 50,
          "minLength": 1
        }
      },
      {
        "label": "性别",
        "type": "radios",
        "name": "gender",
        "required": true,
        "options": [
          {
            "label": "男",
            "value": "男"
          },
          {
            "label": "女",
            "value": "女"
          }
        ]
      },
      {
        "label": "生日",
        "name": "birthday",
        "type": "input-date",
        "embed": false,
        "placeholder": "请选择生日",
        "format": "YYYY-MM-DD"
      },
      {
        "label": "用户关联",
        "type": "radios",
        "name": "userLinkMode",
        "required": true,
        "value": "none",
        "options": [
          {
            "label": "创建新用户",
            "value": "create"
          },
          {
            "label": "关联已有用户",
            "value": "link"
          },
          {
            "label": "不关联用户",
            "value": "none"
          }
        ]
      },
      {
        "label": "用户名/用户ID",
        "type": "input-text",
        "name": "user.userId",
        "placeholder": "关联已有用户时请输入用户ID",
        "clearable": true,
        "required": true,
        "visibleOn": "${userLinkMode === 'link'}",
        "validations": {
          "maxLength": 100,
          "minLength": 1
        }
      },
      {
        "label": "用户名",
        "type": "input-text",
        "name": "user.username",
        "placeholder": "创建新用户时请输入用户名",
        "clearable": true,
        "required": true,
        "visibleOn": "${userLinkMode === 'create'}",
        "validations": {
          "maxLength": 100,
          "minLength": 1
        }
      },
      {
        "label": "密码",
        "type": "input-password",
        "name": "user.password",
        "placeholder": "请输入密码",
        "clearable": true,
        "required": true,
        "visibleOn": "${userLinkMode === 'create'}",
        "validations": {
          "minLength": 6
        }
      },
      {
        "type": "hidden",
        "name": "user.mode",
        "value": "${userLinkMode}"
      },
      {
        "label": "岗位",
        "type": "select",
        "name": "positionId",
        "placeholder": "请选择岗位（可选）",
        "clearable": true,
        "source": {
          "url": "/api/organization/positions",
          "method": "get",
          "data": {
            "departmentId": "${departmentId}"
          }
        },
        "labelField": "name",
        "valueField": "id",
        "searchable": true
      }
    ],
    "wrapWithPanel": false
  }
}
