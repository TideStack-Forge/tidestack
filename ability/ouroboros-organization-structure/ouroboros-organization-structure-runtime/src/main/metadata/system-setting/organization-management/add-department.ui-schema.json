{
  "name": "/system-setting/organization-management/add-department",
  "schema": {
    "type": "form",
    "mode": "horizontal",
    "api": {
      "url": "/api/organization/departments",
      "method": "post"
    },
    "reload": "",
    "title": "",
    "body": [
      {
        "type": "hidden",
        "name": "parentId"
      },
      {
        "label": "部门名称",
        "type": "input-text",
        "name": "name",
        "required": true,
        "placeholder": "",
        "clearable": true,
        "validations": {
          "maxLength": 100,
          "minLength": 1
        }
      },
      {
        "label": "行政级别",
        "name": "adminLevel",
        "type": "select",
        "clearable": true,
        "searchable": true,
        "source": {
          "method": "get",
          "url": "/api/admin-level?scope=DEPT&enabled=true"
        },
        "labelField": "name",
        "valueField": "code"
      },
      {
        "label": "描述",
        "type": "textarea",
        "name": "description",
        "placeholder": "请输入部门描述信息",
        "clearable": true,
        "required": false
      }
    ],
    "wrapWithPanel": false
  }
}
