{
  "name": "/system-setting/integration-management/external-auth/cas",
  "schema": {
    "type": "form",
    "title": false,
    "initApi": "/api/sys/external-auth/cas",
    "api": {
      "method": "put",
      "url": "/api/sys/external-auth/cas",
      "data": {
        "expectedRevision": "${expectedRevision}",
        "changes": "${changes}"
      }
    },
    "body": [
      {
        "type": "alert",
        "level": "info",
        "body": "各身份源沿原登录协议生效。密码留空保留已配置值；可用密钥引用由服务端解析。保存若发生版本冲突，请保留输入并核对最新配置。"
      },
      {
        "type": "combo",
        "name": "changes.providers",
        "label": "身份源",
        "multiple": true,
        "multiLine": true,
        "items": [
          {
            "type": "input-text",
            "name": "key",
            "label": "身份源标识",
            "required": true
          },
          {
            "type": "input-text",
            "name": "displayName",
            "label": "显示名称"
          },
          {
            "type": "switch",
            "name": "enabled",
            "label": "启用登录",
            "value": true
          },
          {
            "type": "input-text",
            "name": "casBaseUrl",
            "label": "CAS 服务地址"
          },
          {
            "type": "input-text",
            "name": "validatePath",
            "label": "票据验证路径"
          },
          {
            "type": "input-text",
            "name": "externalIdField",
            "label": "外部账号标识字段"
          },
          {
            "type": "input-kv",
            "name": "attributeMapping",
            "label": "属性映射"
          }
        ]
      }
    ],
    "actions": [
      {
        "type": "submit",
        "label": "保存登录配置",
        "level": "primary"
      }
    ]
  }
}
