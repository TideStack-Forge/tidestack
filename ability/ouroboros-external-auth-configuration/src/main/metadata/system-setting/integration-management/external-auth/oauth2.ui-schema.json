{
  "name": "/system-setting/integration-management/external-auth/oauth2",
  "schema": {
    "type": "form",
    "title": false,
    "initApi": "/api/sys/external-auth/oauth2",
    "api": {
      "method": "put",
      "url": "/api/sys/external-auth/oauth2",
      "data": {
        "expectedRevision": "${expectedRevision}",
        "changes": "${changes}"
      }
    },
    "body": [
      {
        "type": "alert",
        "level": "info",
        "body": "各身份源沿原登录协议生效。密码留空保留已配置值；可用密钥引用由服务端解析。保存若发生版本冲突，请保留输入并核对最新配置。"
      },
      {
        "type": "combo",
        "name": "changes.providers",
        "label": "身份源",
        "multiple": true,
        "multiLine": true,
        "items": [
          {
            "type": "input-text",
            "name": "key",
            "label": "身份源标识",
            "required": true
          },
          {
            "type": "input-text",
            "name": "displayName",
            "label": "显示名称"
          },
          {
            "type": "switch",
            "name": "enabled",
            "label": "启用登录",
            "value": true
          },
          {
            "type": "input-text",
            "name": "authorizationUri",
            "label": "授权地址"
          },
          {
            "type": "input-text",
            "name": "tokenUri",
            "label": "令牌地址"
          },
          {
            "type": "input-text",
            "name": "userInfoUri",
            "label": "用户信息地址"
          },
          {
            "type": "input-text",
            "name": "userInfoDataField",
            "label": "用户信息数据字段"
          },
          {
            "type": "input-text",
            "name": "jwksUri",
            "label": "JWKS 地址"
          },
          {
            "type": "input-text",
            "name": "issuer",
            "label": "签发者"
          },
          {
            "type": "input-text",
            "name": "clientId",
            "label": "客户端标识"
          },
          {
            "type": "input-text",
            "name": "clientIdRef",
            "label": "客户端标识引用"
          },
          {
            "type": "input-password",
            "name": "clientSecret",
            "label": "客户端密钥（留空保留）"
          },
          {
            "type": "input-text",
            "name": "clientSecretRef",
            "label": "客户端密钥引用"
          },
          {
            "type": "input-tag",
            "name": "scopes",
            "label": "授权范围",
            "joinValues": false,
            "extractValue": true
          },
          {
            "type": "input-text",
            "name": "externalIdField",
            "label": "外部账号标识字段"
          },
          {
            "type": "input-text",
            "name": "memberIdField",
            "label": "企业成员标识字段"
          },
          {
            "type": "switch",
            "name": "pkceEnabled",
            "label": "启用 PKCE"
          },
          {
            "type": "input-text",
            "name": "pkceMethod",
            "label": "PKCE 方法"
          }
        ]
      }
    ],
    "actions": [
      {
        "type": "submit",
        "label": "保存登录配置",
        "level": "primary"
      }
    ]
  }
}
