{
  "name": "/dev/{appName}/data-dict/edit",
  "schema": {
    "type": "form",
    "title": false,
    "wrapWithPanel": false,
    "body": [
      {
        "label": "字典名",
        "type": "static-text",
        "name": "name",
        "required": true,
        "placeholder": "请输入字典名（须符合变量命名规范且唯一）"
      },
      {
        "label": "字典标题",
        "type": "input-text",
        "name": "title",
        "required": true,
        "placeholder": "请输入字典标题"
      },
      {
        "name": "type",
        "type": "list-select",
        "label": "字典类型",
        "multiple": false,
        "required": true,
        "options": [
          {
            "label": "代码表",
            "value": "code_table"
          },
          {
            "label": "枚举值",
            "value": "enum"
          },
          {
            "label": "状态表",
            "value": "state_table"
          }
        ]
      },
      {
        "name": "editable",
        "type": "switch",
        "label": "是否可编辑",
        "value": "${type !== 'code_table' ? false: true}",
        "required": true
      },
      {
        "name": "treeMode",
        "type": "switch",
        "label": "树形模式",
        "value": "${type !== 'code_table' ? false: true}",
        "required": true,
        "disabledOn": "${type !== 'code_table'}"
      },
      {
        "$ref": "dictionaryItem"
      }
    ],
    "mode": "horizontal",
    "initApi": {
      "url": "/api/dev/${appName}/data-dict/${name}",
      "method": "get",
      "adaptor": "function addHasChildrenToItems(arr) {\r\n  arr.forEach(item => {\r\n    if (item.children && item.children.length > 0) {\r\n      item.hasChildren = true;\r\n      addHasChildrenToItems(item.children);\r\n    } else {\r\n      item.hasChildren = false;\r\n    }\r\n  });\r\n  return arr\r\n}\r\nreturn {\r\n  ...payload,\r\n  data: addHasChildrenToItems(payload.data.items)\r\n}"
    },
    "api": {
      "url": "/api/dev/${appName}/data-dict/${name}",
      "method": "put"
    }
  }
}
