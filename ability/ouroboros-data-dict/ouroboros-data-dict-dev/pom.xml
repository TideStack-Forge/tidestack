<project>
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ouroboros</groupId>
        <artifactId>ouroboros-data-dict</artifactId>
        <version>2.0.0-rc.1-SNAPSHOT</version>
    </parent>

    <artifactId>ouroboros-data-dict-dev</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 启用Java 21 编译基线 -->

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-model-manage-webapi-scaffold</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-data-dict-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-field-type-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-web-security-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- groovy 测试编译阶段生效（如果没有此插件groovy不会编译） -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Java 21 编译基线 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Java 21 compile baseline -->
                    <release>21</release>
                    <source>21</source>
                    <target>21</target>
                    <!-- The following setting can be avoided on Java 14 and higher -->
                    <compilerArgs>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 防止在IDEA中build失败-->
        <profile>
            <id>intellij-idea-only</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- JDK21 -->
        <profile>
            <id>jdk21</id>
            <properties>
                <maven.compiler.source>21</maven.compiler.source>
                <maven.compiler.target>21</maven.compiler.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                            <source>21</source>
                            <target>21</target>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
