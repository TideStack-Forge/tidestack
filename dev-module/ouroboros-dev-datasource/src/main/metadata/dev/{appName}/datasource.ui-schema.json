{
  "name": "/dev/{appName}/datasource",
  "schema": {
    "type": "page",
    "body": [
      {
        "type": "crud",
        "id": "datasourceList",
        "syncLocation": false,
        "api": {
          "method": "get",
          "url": "/api/dev/${appName}/datasource"
        },
        "columns": [
          {
            "type": "text",
            "label": "应用数据源名称",
            "name": "dataStationName",
            "inline": true,
            "placeholder": "-"
          },
          {
            "type": "select",
            "name": "platformDataSourceName",
            "label": "绑定平台数据源",
            "labelField": "title",
            "valueField": "name",
            "source": {
              "method": "get",
              "url": "/api/platform-datasource?perPage=9999"
            },
            "static": true
          },
          {
            "type": "operation",
            "label": "操作",
            "buttons": [
              {
                "type": "button",
                "icon": "fa fa-pencil",
                "actionType": "dialog",
                "dialog": {
                  "type": "dialog",
                  "title": "编辑${dataStationName} - 数据源",
                  "url": "/dev/${appName}/datasource/edit"
                }
              },
              {
                "type": "button",
                "actionType": "ajax",
                "icon": "fa fa-times text-danger",
                "confirmText": "确认要删除${dataStationName}（应用内）吗？",
                "api": {
                  "method": "delete",
                  "url": "/api/dev/${appName}/datasource/${id}"
                }
              }
            ],
            "placeholder": "-"
          }
        ],
        "perPageAvailable": [
          10,
          20,
          50
        ],
        "headerToolbar": [
          "reload",
          {
            "type": "button",
            "label": "新增",
            "actionType": "dialog",
            "level": "primary",
            "align": "right",
            "dialog": {
              "type": "dialog",
              "title": "新增数据源",
              "url": "/dev/${appName}/datasource/add"
            }
          }
        ],
        "footerToolbar": [
          "statistics",
          "switch-per-page",
          "pagination"
        ],
        "alwaysShowPagination": true,
        "mode": "table"
      }
    ],
    "asideResizor": false,
    "pullRefresh": {
      "disabled": true
    }
  }
}
