{
  "name": "/dev/apps/edit",
  "schema": {
    "type": "form",
    "mode": "horizontal",
    "title": false,
    "body": [
      {
        "label": "应用名",
        "type": "static-text",
        "name": "name"
      },
      {
        "type": "input-text",
        "label": "应用标题",
        "name": "title",
        "validations": {
          "matchRegexp": "^[\\u4e00-\\u9fa5\\w\\-]+[\\u4e00-\\u9fa5\\w\\-\\d]+$"
        },
        "validationErrors": {
          "matchRegexp": "应用标题只能包含中文、字母、数字、下划线、中划线，且不能以数字开头"
        },
        "required": true
      },
      {
        "type": "ouroboros-icon-picker",
        "name": "icon",
        "label": "图标"
      },
      {
        "type": "textarea",
        "label": "描述",
        "name": "description"
      }
    ],
    "api": {
      "url": "/api/app/${originName}",
      "method": "put"
    },
    "wrapWithPanel": false
  }
}
