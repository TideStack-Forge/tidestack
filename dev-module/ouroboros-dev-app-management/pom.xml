        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-organization-structure-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-websocket-core</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-websocket-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-helper-dev</artifactId>
