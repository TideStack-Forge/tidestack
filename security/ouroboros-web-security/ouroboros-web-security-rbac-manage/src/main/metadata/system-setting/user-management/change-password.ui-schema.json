{
  "name": "/system-setting/user-management/change-password",
  "schema": {
    "type": "form",
    "title": false,
    "mode": "horizontal",
    "horizontal": {
      "left": 3,
      "right": 9
    },
    "api": {
      "method": "patch",
      "url": "/api/sys/user/modify-password",
      "data": {
        "credentials": "${credentials}",
        "newPassword": "${newPassword}",
        "verificationMode": "password"
      }
    },
    "body": [
      {
        "type": "input-password",
        "localeKeys": {
          "label": "changePassword.oldPassword",
          "validationErrors.minLength": "changePassword.validation.oldPasswordRequired"
        },
        "name": "credentials",
        "label": "旧密码",
        "required": true,
        "validations": {
          "minLength": 1
        },
        "validationErrors": {
          "minLength": "请输入旧密码"
        }
      },
      {
        "type": "input-password",
        "localeKeys": {
          "label": "changePassword.newPassword",
          "description": "changePassword.newPassword.description",
          "validationErrors.minLength": "changePassword.validation.newPasswordMinLength"
        },
        "name": "newPassword",
        "label": "新密码",
        "required": true,
        "validations": {
          "minLength": 6
        },
        "description": "至少 6 位，建议不要与近期使用过的密码重复。",
        "validationErrors": {
          "minLength": "密码必须大于六位"
        }
      },
      {
        "type": "input-password",
        "localeKeys": {
          "label": "changePassword.confirmPassword",
          "validationErrors.equalsField": "changePassword.validation.confirmPasswordMismatch"
        },
        "name": "confirmPassword",
        "label": "确认密码",
        "required": true,
        "validations": {
          "equalsField": "newPassword"
        },
        "validationErrors": {
          "equalsField": "两次输入的新密码不一致"
        }
      },
      {
        "type": "alert",
        "localeKeys": {
          "body": "changePassword.notice.passwordUpdated"
        },
        "level": "info",
        "showIcon": true,
        "body": "密码更新后，请使用新密码重新登录。"
      }
    ],
    "actions": [
      {
        "type": "button",
        "localeKeys": {
          "label": "cancel"
        },
        "label": "取消",
        "level": "secondary",
        "actionType": "cancel"
      },
      {
        "type": "submit",
        "localeKeys": {
          "label": "userMenu.changePassword"
        },
        "label": "修改密码",
        "level": "primary"
      }
    ]
  }
}
