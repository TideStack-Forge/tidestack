<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>spreadsheet-parent</artifactId>
        <groupId>com.xinpai.spreadsheet</groupId>
        <version>1.0.0-beta.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xinpai.spreadsheet</groupId>
    <artifactId>spreadsheet-db-mysql</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>spreadsheet-db-mysql</name>
    <description>mysql8实现</description>

    <dependencies>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>

        <!-- spring-jdbc -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <!--阿里的druid数据源-->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <version>1.1.20</version>
        </dependency>

        <!-- mysql  -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.29</version>
        </dependency>

        <!---数据库接口-->
        <dependency>
            <groupId>com.xinpai.spreadsheet</groupId>
            <artifactId>spreadsheet-db</artifactId>
        </dependency>

        <!-- 其他 -->
        <dependency>
            <groupId>com.xinpai.spreadsheet</groupId>
            <artifactId>spreadsheet-utils</artifactId>
        </dependency>

    </dependencies>

