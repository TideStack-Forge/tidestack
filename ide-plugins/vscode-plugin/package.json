          "command": "tidestack.metadata.openVisual",
          "when": "editorLangId == json",
          "group": "navigation@11"
        }
      ],
      "explorer/context": [
        {
          "submenu": "tidestack.develop.projectSubmenu",
          "when": "explorerResourceIsFolder",
          "group": "navigation@18"
        },
        {
          "submenu": "tidestack.metadata.newFileSubmenu",
          "when": "explorerResourceIsFolder",
          "group": "navigation@19"
        },
        {
          "command": "tidestack.metadata.openVisual",
          "when": "resourceExtname == .json",
          "group": "navigation@20"
        }
      ]
