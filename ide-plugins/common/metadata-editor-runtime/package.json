{
  "name": "ouroboros-metadata-editor",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:schema": "npm run build --prefix ../metadata-editor-schema",
    "prepare:schema": "npm run build:schema && node scripts/sync-schema-resources.mjs",
    "clean:dist": "node scripts/clean-dist.mjs",
    "build": "npm run prepare:schema && node scripts/build-editor-bundles.mjs && npm run clean:dist && tsc -p tsconfig.build.json && node scripts/copy-schema-dist.mjs && vite build --config vite.browser-host.config.ts && vite build --config vite.amis-editor.config.ts && cp dist/amis-editor/metadata-editor-amis-editor.js runtime/metadata-editor-amis-editor.js && cp dist/amis-editor/ouroboros-metadata-editor.css runtime/metadata-editor-amis-editor.css",
    "test": "npm run prepare:schema && npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "playwright test"
  },
  "dependencies": {
    "amis": "^6.13.0",
    "amis-core": "^6.13.0",
    "amis-editor": "^6.13.0",
    "amis-editor-core": "^6.13.0",
    "jsonc-parser": "^3.3.1",
    "mobx-react": "^6.3.1",
    "mobx-react-lite": "^2.2.2",
    "monaco-editor": "0.30.1",
    "monaco-editor-textmate": "^4.0.0",
    "monaco-textmate": "^3.0.1",
    "onigasm": "^2.2.5",
    "ouroboros-amis-runtime": "file:../../../frontends/web/ouroboros-amis-runtime",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "amis-theme-editor-helper": "^2.0.27",
    "amis-ui": "^6.13.0",
    "axios": "^1.18.1",
    "downshift": "^9.4.0",
    "file-saver": "^2.0.5",
    "lodash": "^4.18.1",
    "mobx": "^4.15.7",
    "mobx-state-tree": "^3.17.3",
    "moment": "^2.30.1",
    "qiankun": "^2.10.16",
    "react-intersection-observer": "^9.5.2",
    "sortablejs": "^1.15.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react-grid-layout": "^1.5.4",
    "react-resizable": "^3.2.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}
