{
  "type": "notification",
  "fileSuffix": ".notification.json",
  "displayName": "通知模板",
  "sourcePathPatterns": [
    "src/main/metadata/**/*.notification.json"
  ],
  "packagedPathPrefix": "META-INF/ouroboros/metadata",
  "editorKinds": [
    "form"
  ],
  "fileTemplate": {
    "defaultFileName": "example.notification.json",
    "fields": [
      {
        "name": "name",
        "label": "名称",
        "documentPath": [
          "name"
        ],
        "required": true,
        "defaultFromPath": "camel-name"
      },
      {
        "name": "title",
        "label": "标题",
        "documentPath": [
          "title"
        ],
        "required": true,
        "defaultFromPath": "title"
      }
    ],
    "document": {
      "name": "example",
      "title": "示例通知模板",
      "isEnabled": true,
      "payloadSchema": {},
      "channel": {}
    }
  },
  "editorSchema": {
    "type": "form",
    "title": "通知模板",
    "actions": [],
    "body": [
      {
        "type": "input-text",
        "name": "name",
        "label": "名称",
        "required": true
      },
      {
        "type": "input-text",
        "name": "title",
        "label": "标题",
        "required": true
      },
      {
        "type": "switch",
        "name": "isEnabled",
        "label": "启用"
      }
    ]
  },
  "jsonSchemaFile": "schemas/notification.schema.json"
}
