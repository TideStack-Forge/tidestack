<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
        name="ouroboros-module-archetype"
        xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0">

    <requiredProperties>
        <requiredProperty key="autoConfigClassName">
            <defaultValue>AutoConfiguration</defaultValue>
        </requiredProperty>
    </requiredProperties>

    <fileSets>
        <fileSet filtered="false">
            <directory></directory>
            <includes>
                <include>AGENTS.md</include>
                <include>.agents/**</include>
            </includes>
        </fileSet>

        <fileSet filtered="true">
            <directory></directory>
            <includes>
                <include>README.md</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="true">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <fileSet>
            <directory>src/test/java</directory>
            <includes>
                <include>**/*.java</include>
                <include>**/*.groovy</include>
            </includes>
        </fileSet>

        <fileSet filtered="true">
            <directory>src/main/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <fileSet filtered="false">
            <directory>src/main/metadata</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>

        <fileSet>
            <directory>src/test/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
    </fileSets>

</archetype-descriptor>
