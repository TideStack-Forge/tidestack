<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ouroboros</groupId>
        <artifactId>ouroboros-statistics-reporting</artifactId>
        <version>2.0.0-rc.1-SNAPSHOT</version>
    </parent>

    <artifactId>ouroboros-statistics-reporting-dev</artifactId>
    <name>Ouroboros Statistics Reporting Dev</name>

    <dependencies>
        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-business-model-default</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-statistics-reporting-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-statistics-reporting-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-data-typed-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-model-manage-webapi-scaffold</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-version-control-system</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-datasource</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-dev-runtime-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-data-sql-migration</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ouroboros</groupId>
            <artifactId>ouroboros-ui-model-schema</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>jdk21</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <release>21</release>
                            <source>21</source>
                            <target>21</target>
                            <compilerArgs>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
