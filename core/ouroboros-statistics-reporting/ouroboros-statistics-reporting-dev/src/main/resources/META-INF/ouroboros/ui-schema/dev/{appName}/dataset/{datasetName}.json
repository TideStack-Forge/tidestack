{
  "type": "page",
  "initApi": "get:/api/dev/${appName}/dataset/${datasetName}/editor",
  "title": "编辑数据集「${dataset.title || dataset.name || datasetName}」",
  "toolbar": [
    {
      "type": "service",
      "name": "dataset-editor-form-status",
      "data": {
      "dirty": false,
      "submitting": false,
        "activeDialectName": "",
        "initialized": false
      },
      "body": [
        {
          "type": "button",
          "label": "执行并推导字段",
          "level": "link",
          "disabledOn": "${submitting}",
          "onEvent": {
            "click": {
              "actions": [
                {
                  "actionType": "ajax",
                  "outputVar": "inferSchemaResult",
                  "api": {
                    "method": "post",
                    "url": "/api/dev/${appName}/dataset/infer-schema",
                    "data": {
                      "datasetName": "${dataset.name}",
                      "datasource": "${dataset.queryDefinition.datasource || 'default'}",
                      "sql": "$dataset.queryDefinition.sql | raw",
                      "dialectName": "${activeDialectName}",
                      "dialects": "$dataset.queryDefinition.dialects",
                      "parameterDefinitions": "$dataset.parameters"
                    }
                  }
                },
                {
                  "actionType": "setValue",
                  "componentId": "datasetSchemaFields",
                  "ignoreError": false,
                  "args": {
                    "value": "${inferSchemaResult.responseData.fields || []}"
                  }
                },
                {
                  "actionType": "toast",
                  "expression": "${inferSchemaResult.responseData.warnings && inferSchemaResult.responseData.warnings.length}",
                  "args": {
                    "msgType": "warning",
                    "msg": "字段已推导，但存在类型映射警告：${JOIN(inferSchemaResult.responseData.warnings, '；')}"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "button",
          "label": "取消",
          "size": "lg",
          "onEvent": {
            "click": {
              "actions": [
                {
                  "actionType": "confirmDialog",
                  "args": {
                    "title": "确认",
                    "msg": "确定要取消编辑吗？未保存的数据将会丢失！"
                  },
                  "expression": "${dirty}"
                },
                {
                  "actionType": "closeCurrentTab"
                }
              ]
            }
          }
        },
        {
          "type": "button",
          "label": "预览",
          "actionType": "dialog",
          "disabledOn": "${submitting}",
          "dialog": {
            "title": "数据集预览",
            "size": "lg",
            "body": {
              "type": "dataset-preview",
              "api": {
                "method": "post",
                "url": "/api/dev/${appName}/dataset/preview",
                "data": {
                  "datasetName": "${dataset.name}",
                  "dialectName": "${activeDialectName}",
                  "executionContext": {
                    "datasource": "${dataset.queryDefinition.datasource || 'default'}"
                  },
                  "dataset": {
                    "name": "$dataset.name",
                    "title": "$dataset.title",
                    "description": "$dataset.description",
                    "tags": "$dataset.tags",
                    "isEnabled": "$dataset.isEnabled",
                    "queryDefinition": {
                      "type": "$dataset.queryDefinition.type",
                      "datasource": "$dataset.queryDefinition.datasource",
                      "sql": "$dataset.queryDefinition.sql",
                      "dialects": "$dataset.queryDefinition.dialects"
                    },
                    "parameters": "$dataset.parameters",
                    "schema": "$dataset.schema",
                    "permissionDefinition": "$dataset.permissionDefinition",
                    "executionConstraints": "$dataset.executionConstraints"
                  }
                }
              }
            }
          }
        },
        {
          "type": "button",
          "label": "保存",
          "level": "primary",
          "size": "lg",
          "icon": "fa fa-save",
          "hotKey": "ctrl+s,command+s",
          "disabledOn": "${!dirty || submitting}",
          "loadingOn": "${submitting}",
          "onEvent": {
            "click": {
              "actions": [
                {
                  "actionType": "validate",
                  "componentName": "datasetEditorForm"
                },
                {
                  "actionType": "setValue",
                  "componentName": "dataset-editor-form-status",
                  "expression": "${!validateResult.error}",
                  "args": {
                    "value": {
                      "submitting": true
                    }
                  }
                },
                {
                  "actionType": "submit",
                  "componentName": "datasetEditorForm",
                  "expression": "${!validateResult.error}"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "body": {
    "type": "form",
    "id": "datasetEditorForm",
    "name": "datasetEditorForm",
    "wrapWithPanel": false,
    "api": {
      "method": "put",
      "url": "/api/dev/${appName}/dataset/${datasetName}",
      "data": {
      "&": "$dataset",
      "tags": "${dataset.tags || []}"
      },
      "messages": {
        "success": "数据集已保存"
      }
    },
    "onEvent": {
      "inited": {
        "actions": [
          {
            "actionType": "setValue",
            "componentName": "dataset-editor-form-status",
            "args": {
              "value": {
                "dirty": false,
                "submitting": false,
                "initialized": true
              }
            }
          },
          {
            "actionType": "publish",
            "args": {
              "eventName": "statisticsReporting.datasetEditor.initialized",
              "eventData": {
                "datasetName": "${dataset.name}",
                "dataset": "$dataset"
              }
            }
          },
          {
            "actionType": "publish",
            "args": {
              "eventName": "statisticsReporting.datasetEditor.saved",
              "eventData": {
                "datasetName": "${dataset.name}"
              }
            }
          }
        ]
      },
      "submitSucc": {
        "actions": [
          {
            "actionType": "publish",
            "args": {
              "eventName": "statisticsReporting.datasetEditor.saved",
              "eventData": {
                "datasetName": "${dataset.name}"
              }
            }
          },
          {
            "actionType": "setValue",
            "componentName": "dataset-editor-form-status",
            "args": {
              "value": {
                "dirty": false,
                "submitting": false
              }
            }
          },
          {
            "actionType": "sendToOpenerTab",
            "args": {
              "msg": "${result.data || dataset}"
            }
          },
          {
            "actionType": "updateTabTitle",
            "args": {
              "title": "编辑数据集「${(result.data && result.data.title) || dataset.title || dataset.name}」"
            }
          }
        ]
      },
      "submitFail": {
        "actions": [
          {
            "actionType": "setValue",
            "componentName": "dataset-editor-form-status",
            "args": {
              "value": {
                "submitting": false
              }
            }
          }
        ]
      },
      "change": {
        "actions": [
          {
            "actionType": "setValue",
            "componentName": "dataset-editor-form-status",
            "args": {
              "value": {
                "dirty": true
              }
            }
          },
          {
            "actionType": "publish",
            "args": {
              "eventName": "statisticsReporting.datasetEditor.changed",
              "eventData": {
                "datasetName": "${dataset.name}",
                "dataset": "$dataset"
              }
            }
          }
        ]
      }
    },
    "actions": [],
    "body": [
      {
        "type": "container",
        "className": "statistics-dataset-editor-info",
        "bodyClassName": "statistics-dataset-editor-info-fields",
        "body": [
          {
            "type": "grid",
            "columns": [
              {
                "md": 4,
                "body": [
                  {
                    "type": "static",
                    "name": "dataset.name",
                    "label": "名称"
                  }
                ]
              },
              {
                "md": 4,
                "body": [
                  {
                    "type": "input-text",
                    "name": "dataset.title",
                    "label": "标题",
                    "required": true
                  }
                ]
              },
              {
                "md": 4,
                "body": [
                  {
                    "type": "switch",
                    "name": "dataset.isEnabled",
                    "label": "启用",
                    "value": true
                  }
                ]
              }
            ]
          },
          {
            "type": "grid",
            "columns": [
              {
                "md": 8,
                "body": [
                  {
                    "type": "textarea",
                    "name": "dataset.description",
                    "label": "描述",
                    "minRows": 2,
                    "maxRows": 4
                  }
                ]
              },
              {
                "md": 4,
                "body": [
                  {
                    "type": "input-tag",
                    "name": "dataset.tags",
                    "label": "标签",
                    "value": "${dataset.tags || []}",
                    "clearable": true,
                    "joinValues": false,
                    "extractValue": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "grid",
        "className": "statistics-dataset-editor-content",
        "columns": [
          {
            "md": 7,
            "body": [
              {
                "type": "dataset-sql-editor",
                "name": "dataset.queryDefinition",
                "label": false,
                "datasourceOptions": "${datasourceOptions}",
                "onEvent": {
                  "dialectChange": {
                    "actions": [
                      {
                        "actionType": "setValue",
                        "componentName": "dataset-editor-form-status",
                        "args": {
                          "value": {
                            "activeDialectName": "${event.data.dialectName}"
                          }
                        }
                      }
                    ]
                  },
                  "saveShortcut": {
                    "actions": [
                      {
                        "actionType": "validate",
                        "componentName": "datasetEditorForm"
                      },
                      {
                        "actionType": "setValue",
                        "componentName": "dataset-editor-form-status",
                        "expression": "${!validateResult.error}",
                        "args": {
                          "value": {
                            "submitting": true
                          }
                        }
                      },
                      {
                        "actionType": "submit",
                        "componentName": "datasetEditorForm",
                        "expression": "${!validateResult.error}"
                      }
                    ]
                  }
                }
              }
            ]
          },
          {
            "md": 5,
            "body": [
              {
                "type": "tabs",
                "className": "statistics-dataset-metadata-tabs",
                "tabs": [
                  {
                    "title": "参数定义",
                    "body": [
                      {
                        "type": "input-table",
                        "name": "dataset.parameters",
                        "label": false,
                        "lazyRenderAfter": 0,
                        "addable": true,
                        "removable": true,
                        "draggable": true,
                        "needConfirm": false,
                        "showIndex": true,
                        "addButtonText": "新增参数",
                        "columns": [
                          {
                            "name": "name",
                            "label": "参数名",
                            "type": "input-text",
                            "required": true,
                            "placeholder": "startDate",
                            "width": 150
                          },
                          {
                            "name": "title",
                            "label": "显示名",
                            "type": "input-text",
                            "width": 150
                          },
                          {
                            "name": "type",
                            "label": "类型",
                            "type": "select",
                            "value": "string",
                            "width": 120,
                            "options": [
                              {
                                "label": "字符串",
                                "value": "string"
                              },
                              {
                                "label": "数字",
                                "value": "number"
                              },
                              {
                                "label": "日期",
                                "value": "date"
                              },
                              {
                                "label": "日期时间",
                                "value": "datetime"
                              },
                              {
                                "label": "布尔",
                                "value": "boolean"
                              }
                            ]
                          },
                          {
                            "name": "required",
                            "label": "必填",
                            "type": "switch",
                            "width": 90
                          },
                          {
                            "name": "multiValue",
                            "label": "多值",
                            "type": "switch",
                            "width": 90
                          },
                          {
                            "name": "visibleInView",
                            "label": "视图可见",
                            "type": "switch",
                            "value": true,
                            "width": 100
                          },
                          {
                            "name": "defaultValue",
                            "label": "默认值",
                            "type": "input-text",
                            "width": 150
                          },
                          {
                            "name": "operator",
                            "label": "操作符",
                            "type": "select",
                            "clearable": true,
                            "width": 110,
                            "options": [
                              { "label": "等于", "value": "eq" },
                              { "label": "不等于", "value": "ne" },
                              { "label": "大于", "value": "gt" },
                              { "label": "大于等于", "value": "gte" },
                              { "label": "小于", "value": "lt" },
                              { "label": "小于等于", "value": "lte" },
                              { "label": "包含于", "value": "in" },
                              { "label": "不包含于", "value": "notIn" },
                              { "label": "模糊匹配", "value": "like" }
                            ]
                          },
                          {
                            "name": "allowEmptyOmitCondition",
                            "label": "空值忽略条件",
                            "type": "switch",
                            "width": 120
                          },
                          {
                            "name": "valueSource",
                            "label": "值来源",
                            "type": "select",
                            "clearable": true,
                            "width": 110,
                            "options": [
                              { "label": "请求参数", "value": "request" },
                              { "label": "系统上下文", "value": "systemContext" }
                            ]
                          },
                          {
                            "name": "systemContextBinding",
                            "label": "上下文绑定",
                            "type": "input-text",
                            "width": 150
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "title": "输出字段 Schema",
                    "body": [
                      {
                        "type": "input-table",
                        "id": "datasetSchemaFields",
                        "name": "dataset.schema.fields",
                        "label": false,
                        "lazyRenderAfter": 0,
                        "addable": true,
                        "removable": true,
                        "draggable": true,
                        "needConfirm": false,
                        "showIndex": true,
                        "addButtonText": "新增字段",
                        "placeholder": "执行推导后会填充字段，也可以手动维护。",
                        "columns": [
                          {
                            "name": "name",
                            "label": "字段名",
                            "type": "input-text",
                            "required": true,
                            "width": 150
                          },
                          {
                            "name": "title",
                            "label": "显示名",
                            "type": "input-text",
                            "required": true,
                            "width": 150
                          },
                          {
                            "name": "dataType",
                            "label": "数据类型",
                            "type": "select",
                            "required": true,
                            "width": 120,
                            "options": [
                              {
                                "label": "字符串",
                                "value": "string"
                              },
                              {
                                "label": "数字",
                                "value": "number"
                              },
                              {
                                "label": "整数",
                                "value": "integer"
                              },
                              {
                                "label": "小数",
                                "value": "decimal"
                              },
                              {
                                "label": "日期",
                                "value": "date"
                              },
                              {
                                "label": "日期时间",
                                "value": "datetime"
                              },
                              {
                                "label": "布尔",
                                "value": "boolean"
                              }
                            ]
                          },
                          {
                            "name": "semanticRole",
                            "label": "语义角色",
                            "type": "select",
                            "required": true,
                            "clearable": true,
                            "width": 120,
                            "options": [
                              {
                                "label": "标识",
                                "value": "identifier"
                              },
                              {
                                "label": "维度",
                                "value": "dimension"
                              },
                              {
                                "label": "指标",
                                "value": "metric"
                              },
                              {
                                "label": "明细",
                                "value": "detail"
                              },
                              {
                                "label": "时间",
                                "value": "time"
                              }
                            ]
                          },
                          {
                            "name": "nullable",
                            "label": "可空",
                            "type": "switch",
                            "value": true,
                            "width": 90
                          },
                          {
                            "name": "filterable",
                            "label": "可过滤",
                            "type": "switch",
                            "width": 90
                          },
                          {
                            "name": "sortable",
                            "label": "可排序",
                            "type": "switch",
                            "width": 90
                          },
                          {
                            "name": "exportable",
                            "label": "可导出",
                            "type": "switch",
                            "value": true,
                            "width": 90
                          },
                          {
                            "name": "visibleByDefault",
                            "label": "默认显示",
                            "type": "switch",
                            "value": true,
                            "width": 100
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "title": "执行限制",
                    "body": [{ "type": "statistics-execution-policy", "name": "dataset.executionConstraints", "label": false, "appName": "${appName}" }]
                  },
                  {
                    "title": "访问与数据范围",
                    "body": [
                      {
                        "type": "dataset-authorization-status",
                        "datasetName": "${dataset.name}"
                      },
                      {
                        "type": "tpl",
                        "tpl": "数据范围绑定",
                        "className": "statistics-dataset-access-title"
                      },
                      {
                        "type": "input-kv",
                        "name": "dataset.permissionDefinition.scopeBindings",
                        "label": false,
                        "addButtonText": "添加范围绑定",
                        "description": "执行时从账户上下文取值，同名请求参数会被覆盖。缺失上下文时拒绝查询。",
                        "keySchema": {
                          "type": "select",
                          "name": "key",
                          "label": "查询参数",
                          "required": true,
                          "source": "${dataset.parameters}",
                          "labelField": "name",
                          "valueField": "name",
                          "searchable": true
                        },
                        "valueSchema": {
                          "type": "select",
                          "name": "value",
                          "label": "账户上下文",
                          "required": true,
                          "options": [
                            {
                              "label": "当前用户",
                              "value": "currentUser"
                            },
                            {
                              "label": "当前员工",
                              "value": "employeeId"
                            },
                            {
                              "label": "当前部门",
                              "value": "departmentId"
                            },
                            {
                              "label": "当前组织",
                              "value": "organizationId"
                            }
                          ],
                          "searchable": true
                        },
                        "canAccessSuperData": true
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
