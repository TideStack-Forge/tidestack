{
  "name": "/dev/{appName}/analytics/dataset-tables",
  "schema": {
    "type": "service",
    "api": {
      "method": "post",
      "url": "/api/dev/${appName}/dataset/datasource-tables",
      "data": {
        "datasource": "${tableDatasourceName}",
        "testConnection": "${!tableDatasourceName || tableDatasourceName === \"default\" ? devConfig.testConnection : {kind: \"application\"}}"
      }
    },
    "body": [
      {
        "type": "tpl",
        "tpl": "${JOIN(warnings, \"；\")}",
        "className": "text-muted mb-2",
        "visibleOn": "${warnings && warnings.length}"
      },
      {
        "type": "table",
        "source": "${items}",
        "placeholder": "当前数据源暂无可用表",
        "columns": [
          {
            "name": "name",
            "label": "表名"
          },
          {
            "name": "title",
            "label": "名称"
          },
          {
            "name": "model",
            "label": "数据模型"
          },
          {
            "name": "source",
            "label": "来源",
            "type": "mapping",
            "map": {
              "model": "数据模型",
              "database": "数据库"
            }
          },
          {
            "name": "columns",
            "label": "字段",
            "type": "table",
            "columns": [
              {
                "name": "name",
                "label": "字段名"
              },
              {
                "name": "title",
                "label": "名称"
              },
              {
                "name": "dataType",
                "label": "类型"
              }
            ]
          }
        ]
      }
    ]
  }
}
