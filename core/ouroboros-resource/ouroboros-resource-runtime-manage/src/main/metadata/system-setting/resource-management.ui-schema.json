{
  "name": "/system-setting/resource-management",
  "schema": {
    "type": "page",
    "title": "资源管理",
    "aside": [
      {
        "size": "sm",
        "style": {
          "display": "block",
          "position": "static"
        },
        "wrapperBody": false,
        "isFixedHeight": false,
        "type": "container",
        "body": [
          {
            "type": "tpl",
            "tpl": "<div class='text-muted m-b-xs'>目录</div>"
          },
          {
            "type": "input-tree",
            "name": "resourceDirectoryTree",
            "label": "",
            "value": "",
            "enableNodePath": false,
            "multiple": false,
            "source": {
              "method": "get",
              "url": "/api/sys/resource/runtime/directories?scope=${scope}",
              "responseData": {
                "items": [
                  {
                    "label": "全部资源",
                    "value": "",
                    "icon": "folder",
                    "children": "$items"
                  }
                ]
              }
            },
            "valueField": "value",
            "labelField": "label",
            "showIcon": true,
            "initiallyOpen": true,
            "heightAuto": true,
            "onEvent": {
              "change": {
                "actions": [
                  {
                    "actionType": "reload",
                    "componentName": "resourceList",
                    "args": {
                      "resetPage": true
                    },
                    "dataMergeMode": "merge",
                    "data": {
                      "resourceDirectoryTree": "${event.data.value}"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ],
    "toolbar": [
      {
        "type": "button",
        "label": "新建覆盖资源",
        "level": "primary",
        "actionType": "drawer",
        "drawer": {
          "title": "新建覆盖资源",
          "size": "md",
          "url": "/system-setting/resource-management/upload"
        }
      },
      "reload"
    ],
    "body": [
      {
        "type": "container",
        "className": "mb-2",
        "wrapperBody": false,
        "isFixedHeight": false,
        "style": {
          "display": "flex",
          "alignItems": "center",
          "gap": "12px",
          "flexWrap": "wrap"
        },
        "body": [
          {
            "type": "button-group-select",
            "name": "scope",
            "value": "frontend",
            "options": [
              {
                "label": "前端资源",
                "value": "frontend"
              },
              {
                "label": "后端资源",
                "value": "backend"
              }
            ],
            "onEvent": {
              "change": {
                "actions": [
                  {
                    "actionType": "reload",
                    "componentName": "resourceDirectoryTree",
                    "dataMergeMode": "merge",
                    "data": {
                      "scope": "${event.data.value}",
                      "resourceDirectoryTree": ""
                    }
                  },
                  {
                    "actionType": "reload",
                    "componentName": "resourceList",
                    "args": {
                      "resetPage": true
                    },
                    "dataMergeMode": "merge",
                    "data": {
                      "scope": "${event.data.value}",
                      "resourceDirectoryTree": ""
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "tpl",
            "tpl": "<span class='text-muted'>运行时按目录查看当前生效资源，重点关注覆盖状态与生效层。</span>"
          }
        ]
      },
      {
        "type": "crud",
        "name": "resourceList",
        "id": "resourceList",
        "syncLocation": false,
        "api": {
          "method": "get",
          "url": "/api/sys/resource/runtime",
          "data": {
            "scope": "$scope",
            "directory": "$resourceDirectoryTree",
            "keyword": "$keyword"
          }
        },
        "filter": {
          "title": "",
          "submitText": "搜索",
          "body": [
            {
              "type": "input-text",
              "name": "keyword",
              "label": "关键字",
              "placeholder": "按资源 Key 或显示名称搜索",
              "clearable": true
            }
          ]
        },
        "headerToolbar": [
          "filter-toggler",
          "reload"
        ],
        "columns": [
          {
            "name": "scope",
            "label": "范围",
            "type": "mapping",
            "map": {
              "frontend": "<span class='label label-success'>前端</span>",
              "backend": "<span class='label label-warning'>后端</span>"
            }
          },
          {
            "name": "key",
            "label": "资源 Key"
          },
          {
            "name": "displayName",
            "label": "显示名称"
          },
          {
            "name": "contentType",
            "label": "内容类型"
          },
          {
            "name": "size",
            "label": "大小(B)"
          },
          {
            "name": "effectiveLayer",
            "label": "生效层",
            "type": "mapping",
            "map": {
              "app_default": "<span class='label label-info'>应用默认</span>",
              "runtime_override": "<span class='label label-danger'>运行时覆盖</span>"
            }
          },
          {
            "name": "hasOverride",
            "label": "已覆盖",
            "type": "mapping",
            "map": {
              "true": "是",
              "false": "否"
            }
          },
          {
            "name": "defaultExists",
            "label": "有默认值",
            "type": "mapping",
            "map": {
              "true": "是",
              "false": "否"
            }
          },
          {
            "type": "operation",
            "label": "操作",
            "buttons": [
              {
                "type": "button",
                "label": "详情",
                "level": "link",
                "actionType": "drawer",
                "drawer": {
                  "title": "资源详情",
                  "size": "lg",
                  "url": "/system-setting/resource-management/detail?scope=${scope}&key=${key}"
                }
              },
              {
                "type": "button",
                "label": "下载当前生效",
                "level": "link",
                "actionType": "download",
                "api": {
                  "method": "get",
                  "url": "/api/sys/resource/runtime/content?scope=${scope}&key=${key}"
                }
              },
              {
                "type": "button",
                "label": "上传覆盖",
                "level": "link",
                "actionType": "drawer",
                "drawer": {
                  "title": "上传资源覆盖",
                  "size": "md",
                  "url": "/system-setting/resource-management/upload?scope=${scope}&key=${key}"
                }
              },
              {
                "type": "button",
                "label": "删除覆盖",
                "level": "link",
                "className": "text-danger",
                "visibleOn": "${hasOverride}",
                "actionType": "ajax",
                "confirmText": "确认删除当前运行时覆盖吗？",
                "api": {
                  "method": "delete",
                  "url": "/api/sys/resource/runtime/content?scope=${scope}&key=${key}"
                }
              },
              {
                "type": "button",
                "label": "恢复默认",
                "level": "link",
                "visibleOn": "${hasOverride && defaultExists}",
                "actionType": "ajax",
                "confirmText": "确认恢复为应用默认资源吗？",
                "api": {
                  "method": "post",
                  "url": "/api/sys/resource/runtime/restore?scope=${scope}&key=${key}"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
