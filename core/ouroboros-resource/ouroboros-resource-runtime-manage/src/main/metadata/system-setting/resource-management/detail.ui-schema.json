{
  "name": "/system-setting/resource-management/detail",
  "schema": {
    "type": "page",
    "title": "资源详情",
    "body": {
      "type": "service",
      "api": {
        "method": "get",
        "url": "/api/sys/resource/runtime/effective?scope=${scope}&key=${key}"
      },
      "body": [
        {
          "type": "panel",
          "title": "基础信息",
          "body": [
            {
              "type": "property",
              "items": [
                {
                  "label": "范围",
                  "content": "${scope}"
                },
                {
                  "label": "资源 Key",
                  "content": "${key}"
                },
                {
                  "label": "显示名称",
                  "content": "${displayName || '-'}"
                },
                {
                  "label": "内容类型",
                  "content": "${contentType || '-'}"
                },
                {
                  "label": "大小(B)",
                  "content": "${size || '-'}"
                },
                {
                  "label": "生效层",
                  "content": "${effectiveLayer || '-'}"
                },
                {
                  "label": "有运行时覆盖",
                  "content": "${hasOverride ? '是' : '否'}"
                },
                {
                  "label": "有应用默认",
                  "content": "${defaultExists ? '是' : '否'}"
                },
                {
                  "label": "描述",
                  "content": "${description || '-'}"
                }
              ]
            }
          ]
        },
        {
          "type": "button-toolbar",
          "buttons": [
            {
              "type": "button",
              "label": "上传覆盖",
              "level": "primary",
              "actionType": "drawer",
              "drawer": {
                "title": "上传资源覆盖",
                "size": "md",
                "url": "/system-setting/resource-management/upload?scope=${scope}&key=${key}"
              }
            },
            {
              "type": "button",
              "label": "恢复默认",
              "level": "warning",
              "visibleOn": "${hasOverride && defaultExists}",
              "actionType": "ajax",
              "confirmText": "确认恢复为应用默认资源吗？",
              "api": {
                "method": "post",
                "url": "/api/sys/resource/runtime/restore?scope=${scope}&key=${key}"
              }
            },
            {
              "type": "button",
              "label": "下载当前生效",
              "level": "link",
              "actionType": "download",
              "api": {
                "method": "get",
                "url": "/api/sys/resource/runtime/content?scope=${scope}&key=${key}"
              }
            }
          ]
        }
      ]
    }
  }
}
