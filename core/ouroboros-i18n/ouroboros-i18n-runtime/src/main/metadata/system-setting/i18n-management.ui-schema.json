{
  "name": "/system-setting/i18n-management",
  "schema": {
    "type": "page",
    "title": "语言管理",
    "body": {
      "type": "crud",
      "api": "/api/i18n/manage/languages",
      "syncLocation": false,
      "headerToolbar": [
        {
          "type": "reload"
        },
        {
          "type": "button",
          "label": "导出语言模板",
          "level": "enhance",
          "actionType": "download",
          "api": "/api/i18n/manage/template/export"
        },
        {
          "type": "button",
          "label": "导入翻译文件",
          "level": "primary",
          "actionType": "dialog",
          "align": "right",
          "dialog": {
            "title": "导入语言文件",
            "size": "md",
            "url": "/i18n/import"
          }
        }
      ],
      "columns": [
        {
          "name": "locale",
          "label": "语言代码",
          "type": "text",
          "width": 120
        },
        {
          "name": "name",
          "label": "语言名称",
          "type": "text",
          "width": 150
        },
        {
          "name": "enabled",
          "label": "状态",
          "type": "status",
          "width": 80,
          "map": {
            "true": "<span class='label label-success'>启用</span>",
            "false": "<span class='label label-default'>禁用</span>"
          }
        },
        {
          "name": "isDefault",
          "label": "默认语言",
          "type": "status",
          "width": 100,
          "map": {
            "true": "<span class='label label-info'>是</span>",
            "false": "<span class='label label-default'>否</span>"
          }
        },
        {
          "name": "messageCount",
          "label": "文案数量",
          "type": "text",
          "width": 100
        },
        {
          "name": "direction",
          "label": "文本方向",
          "type": "text",
          "width": 100
        },
        {
          "name": "version",
          "label": "版本",
          "type": "text",
          "width": 100
        },
        {
          "name": "operation",
          "label": "操作",
          "type": "operation",
          "width": 200,
          "buttons": [
            {
              "type": "button",
              "label": "查看",
              "level": "default",
              "actionType": "dialog",
              "dialog": {
                "title": "语言详情 - ${locale}",
                "size": "lg",
                "body": {
                  "type": "form",
                  "initApi": {
                    "url": "/api/i18n/manage/languages/${locale}",
                    "responseData": {
                      "localeData": "$$"
                    }
                  },
                  "body": [
                    {
                      "type": "json-editor",
                      "name": "localeData",
                      "label": "语言信息",
                      "disabled": true,
                      "options": {
                        "mode": "code"
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "导出",
              "level": "enhance",
              "size": "sm",
              "actionType": "download",
              "api": "/api/i18n/manage/languages/${locale}/export"
            },
            {
              "type": "dropdown-button",
              "label": "操作",
              "level": "enhance",
              "size": "sm",
              "buttons": [
                {
                  "type": "button",
                  "label": "同步文案",
                  "actionType": "dialog",
                  "dialog": {
                    "title": "同步文案 - ${locale}",
                    "size": "sm",
                    "body": {
                      "type": "form",
                      "api": {
                        "method": "post",
                        "url": "/api/i18n/manage/sync"
                      },
                      "body": [
                        {
                          "type": "hidden",
                          "name": "locale",
                          "value": "${locale}"
                        },
                        {
                          "type": "checkbox",
                          "name": "removeOrphaned",
                          "label": "删除多余文案",
                          "description": "勾选后将删除不在提取器中的翻译键"
                        }
                      ],
                      "onEvent": {
                        "submitSucc": {
                          "actions": [
                            {
                              "actionType": "toast",
                              "args": {
                                "msgType": "success",
                                "msg": "同步完成！新增 ${result.data.added} 条，删除 ${result.data.removed} 条"
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                },
                {
                  "type": "divider"
                },
                {
                  "type": "button",
                  "label": "设为默认",
                  "actionType": "ajax",
                  "confirmText": "确定要将 ${locale} 设为默认语言吗？",
                  "api": {
                    "method": "post",
                    "url": "/api/i18n/manage/languages/${locale}/set-default"
                  },
                  "messages": {
                    "success": "已成功设置默认语言"
                  },
                  "disabledOn": "${isDefault || !enabled}"
                },
                {
                  "type": "button",
                  "label": "${enabled ? '禁用' : '启用'}",
                  "actionType": "ajax",
                  "confirmText": "${enabled ? '确定要禁用' : '确定要启用'} ${locale} 语言吗？",
                  "api": {
                    "method": "post",
                    "url": "/api/i18n/manage/languages/${locale}/enabled?enabled=${!enabled}"
                  },
                  "messages": {
                    "success": "${enabled ? '已禁用' : '已启用'}语言"
                  },
                  "disabledOn": "${isDefault}"
                },
                {
                  "type": "button",
                  "label": "删除",
                  "className": "text-danger",
                  "actionType": "ajax",
                  "confirmText": "确定要删除 ${locale} 语言吗？此操作不可恢复！",
                  "api": {
                    "method": "delete",
                    "url": "/api/i18n/manage/languages/${locale}"
                  },
                  "messages": {
                    "success": "已成功删除语言"
                  },
                  "disabledOn": "${isDefault || !hasDbRecord}"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
