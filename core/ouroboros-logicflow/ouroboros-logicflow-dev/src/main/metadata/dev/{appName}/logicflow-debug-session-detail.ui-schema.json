{
  "name": "/dev/{appName}/logicflow-debug-session-detail",
  "schema": {
    "type": "page",
    "title": "调试会话详情 - ${sessionId}",
    "initApi": {
      "method": "get",
      "url": "/api/dev/${appName}/logicflow/debug/sessions/${sessionId}"
    },
    "body": [
      {
        "type": "panel",
        "title": "会话信息",
        "body": [
          {
            "type": "property",
            "title": "会话ID",
            "content": "${sessionId}"
          },
          {
            "type": "property",
            "title": "逻辑流名称",
            "content": "${flowName}"
          },
          {
            "type": "property",
            "title": "开始时间",
            "content": "${startedAt | date:YYYY-MM-DD HH\\:mm\\:ss}"
          },
          {
            "type": "property",
            "title": "最后事件时间",
            "content": "${lastEventAt | date:YYYY-MM-DD HH\\:mm\\:ss}"
          },
          {
            "type": "property",
            "title": "状态",
            "content": "${status}"
          },
          {
            "type": "property",
            "title": "事件数量",
            "content": "${eventCount}"
          }
        ]
      },
      {
        "type": "panel",
        "title": "执行事件",
        "body": [
          {
            "type": "crud",
            "name": "eventList",
            "api": {
              "method": "get",
              "url": "/api/dev/${appName}/logicflow/debug/sessions/${sessionId}/events"
            },
            "columns": [
              {
                "name": "seq",
                "label": "序号",
                "type": "text",
                "width": 80
              },
              {
                "name": "timestamp",
                "label": "时间",
                "type": "datetime",
                "format": "HH:mm:ss.SSS",
                "width": 120
              },
              {
                "name": "eventType",
                "label": "事件类型",
                "type": "mapping",
                "map": {
                  "flow.started": "<span class='label label-info'>流程开始</span>",
                  "flow.completed": "<span class='label label-success'>流程完成</span>",
                  "flow.failed": "<span class='label label-danger'>流程失败</span>",
                  "node.started": "<span class='label label-primary'>节点开始</span>",
                  "node.completed": "<span class='label label-success'>节点完成</span>",
                  "node.failed": "<span class='label label-danger'>节点失败</span>",
                  "node.skipped": "<span class='label label-default'>节点跳过</span>"
                },
                "width": 120
              },
              {
                "name": "nodeName",
                "label": "节点名称",
                "type": "text"
              },
              {
                "name": "message",
                "label": "消息",
                "type": "text"
              },
              {
                "type": "operation",
                "label": "操作",
                "width": 100,
                "buttons": [
                  {
                    "type": "button",
                    "label": "详情",
                    "level": "link",
                    "actionType": "dialog",
                    "dialog": {
                      "title": "事件详情",
                      "size": "lg",
                      "body": {
                        "type": "json",
                        "name": "payload",
                        "levelExpand": 3
                      },
                      "data": {
                        "payload": "${payload}"
                      }
                    }
                  }
                ]
              }
            ],
            "footerToolbar": [
              "statistics",
              "pagination"
            ],
            "perPage": 50,
            "loadDataOnce": true
          }
        ]
      }
    ]
  }
}
