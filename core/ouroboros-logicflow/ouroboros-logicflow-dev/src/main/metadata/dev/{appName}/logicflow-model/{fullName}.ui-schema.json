{
  "name": "/dev/{appName}/logicflow-model/{fullName}",
  "schema": {
    "type": "page",
    "title": "编辑逻辑流「${fullName}」",
    "css": {
      ".editor-panel-body": {
        "padding": "0",
        "height": "100%"
      },
      ".cxd-Page-body": {
        "flex-grow": 1,
        "flex-shrink": 1,
        "height": "500px"
      }
    },
    "bodyClassName": "p-0",
    "toolbar": [
      {
        "type": "amis-schema",
        "source": {
          "method": "get",
          "url": "/api/dev-fragment-schema/vcs-buttons",
          "data": {
            "apiPath": "logic-flow/${fullName}",
            "statusId": "logicFlowStatus",
            "formId": "logicFlowForm",
            "actionType": "static"
          }
        }
      }
    ],
    "body": [
      {
        "type": "form",
        "name": "logicFlowForm",
        "id": "logicFlowForm",
        "initApi": {
          "url": "/api/dev/${appName}/logic-flow/${fullName}?includeValidationSnapshot=true",
          "method": "get",
          "responseData": {
            "flowModel": "$flowModel",
            "validationSnapshot": "$validationSnapshot"
          }
        },
        "api": {
          "url": "/api/dev/${appName}/logic-flow/${fullName}?includeValidationSnapshot=true",
          "method": "put",
          "data": "${flowModel}"
        },
        "wrapWithPanel": false,
        "className": "h-full",
        "bodyClassName": "h-full flex flex-col",
        "mode": "horizontal",
        "title": false,
        "body": [
          {
            "type": "logic-flow-editor",
            "label": false,
            "name": "flowModel",
            "className": "h-full flex-grow",
            "inputClassName": "h-full flex-grow",
            "nodeDefineApi": "/api/dev/${appName}/logicflow/node-define",
            "validationSnapshot": "${validationSnapshot}",
            "navigationTargetNodeName": "${navigationTargetNodeName}",
            "navigationTargetRequestKey": "${navigationTargetRequestKey}"
          }
        ],
        "actions": [],
        "onEvent": {
          "submitSucc": {
            "actions": [
              {
                "actionType": "setValue",
                "componentId": "logicFlowForm",
                "args": {
                  "value": {
                    "flowModel": "${result.data.flowModel}",
                    "validationSnapshot": "${result.data.validationSnapshot}"
                  }
                }
              },
              {
                "actionType": "toast",
                "expression": "${(result.data.validationSnapshot.validationDiagnostics && result.data.validationSnapshot.validationDiagnostics.length) || (result.data.validationSnapshot.validationErrors && result.data.validationSnapshot.validationErrors.length) || result.data.validationSnapshot.validationSummary}",
                "args": {
                  "msgType": "warning",
                  "msg": "${result.data.validationSnapshot.validationSummary ? '已保存，但存在后端校验错误：' + result.data.validationSnapshot.validationSummary : '已保存，但存在后端校验错误'}"
                }
              },
              {
                "actionType": "toast",
                "expression": "${!((result.data.validationSnapshot.validationDiagnostics && result.data.validationSnapshot.validationDiagnostics.length) || (result.data.validationSnapshot.validationErrors && result.data.validationSnapshot.validationErrors.length) || result.data.validationSnapshot.validationSummary)}",
                "args": {
                  "msgType": "success",
                  "msg": "保存成功"
                }
              },
              {
                "actionType": "sendToOpenerTab",
                "args": {
                  "msg": "${result.data.flowModel}"
                }
              },
              {
                "actionType": "updateTabTitle",
                "args": {
                  "title": "编辑逻辑流「${result.data.flowModel.name}」"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
