  "shape": "rect",
  "description": "从文件路径、上传文件对象、文件对象、输入流、内存缓冲等数据源读取 Excel 文件内容",
  "group": "文件格式",
  "order": 9001,
  "scaffold": {
    "type": "readExcel",
    "name": "读取Excel",
    "inputPorts": [
      {
        "name": "",
        "description": "",
        "dataType": "any"
      }
    ],
    "outputPorts": [
      {
        "name": "",
        "description": "",
        "dataType": "any"
      }
    ]
  },
  "portRules": {
    "input": {
      "ruleType": "limit",
      "min": 1,
      "max": 1
    },
    "output": {
      "ruleType": "limit",
      "min": 1,
      "max": 1
    }
  },
  "properties": [
    {
      "type": "input-text",
      "name": "excelSourcePath",
      "label": "Excel数据源",
      "value": "data.file"
    },
    {
      "type": "input-text",
      "name": "xlsFlagPath",
      "label": "XLS格式标识",
      "value": "data.isXls"
    },
    {
      "type": "button-group-select",
      "name": "sheetSelectionMode",
      "label": "读取范围",
      "value": "Single",
      "options": [
        {
          "label": "单工作表",
          "value": "Single"
        },
        {
          "label": "多工作表",
          "value": "Multiple"
        },
        {
          "label": "全部",
          "value": "All"
        }
      ]
    },
    {
      "type": "button-group-select",
      "name": "sheetIdentifierType",
      "label": "工作表选择方式",
      "value": "Index",
      "options": [
        {
          "label": "索引",
          "value": "Index"
        },
        {
          "label": "名称",
          "value": "Name"
        }
      ],
      "visibleOn": "${ sheetSelectionMode !== 'All'}"
    },
    {
      "type": "input-text",
      "name": "sheetName",
      "label": "工作表名",
      "required": true,
      "visibleOn": "${ sheetSelectionMode == 'Single' && sheetIdentifierType == 'Name'}"
    },
    {
      "type": "input-number",
      "name": "sheetIndex",
      "label": "工作表索引",
      "required": true,
      "min": 0,
      "value": 0,
      "visibleOn": "${ sheetSelectionMode == 'Single' && sheetIdentifierType == 'Index'}"
    },
    {
      "type": "input-array",
      "name": "sheetNames",
      "label": "工作表名",
      "required": true,
      "items": [
        {
          "type": "input-text"
        }
      ],
      "visibleOn": "${ sheetSelectionMode == 'Multiple' && sheetIdentifierType == 'Name'}"
    },
    {
      "type": "input-array",
      "name": "sheetIndexes",
      "label": "工作表索引",
      "required": true,
      "items": [
        {
          "type": "input-number",
          "min": 0
        }
      ],
      "visibleOn": "${ sheetSelectionMode == 'Multiple' && sheetIdentifierType == 'Index'}"
    },
    {
      "type": "button-group-select",
      "name": "multiSheetResultFormat",
      "label": "多工作表读取格式",
      "value": "Map",
      "options": [
        {
          "label": "Map格式",
          "value": "Map"
        },
        {
          "label": "列表格式",
          "value": "List"
        }
      ],
      "hiddenOn": "${ sheetSelectionMode == 'Single' }"
    },
    {
      "type": "button-group-select",
      "name": "sheetDataFormat",
      "label": "工作表数据格式",
      "value": "ListOfMap",
      "options": [
        {
          "label": "行数据为Map的行列表",
          "value": "ListOfMap"
        },
        {
          "label": "行数据为List的行列表",
          "value": "ListOfList"
        },
        {
          "label": "SheetData对象",
          "value": "SheetData"
        }
      ],
      "hiddenOn": "${ sheetSelectionMode == 'Single' }"
    },
    {
      "type": "input-number",
      "name": "startRow",
      "label": "开始行索引",
      "required": true,
      "value": 0,
      "min": 0
    },
    {
      "type": "input-number",
      "name": "startColumn",
      "label": "开始列索引",
      "required": true,
      "value": 0,
      "min": 0
    },
    {
      "type": "input-number",
      "name": "maxRows",
      "label": "最大读取行数",
      "clearValueOnEmpty": true
    },
    {
      "type": "input-number",
      "name": "maxColumn",
      "label": "最大读取列树",
      "clearValueOnEmpty": true
    }
  ]
}