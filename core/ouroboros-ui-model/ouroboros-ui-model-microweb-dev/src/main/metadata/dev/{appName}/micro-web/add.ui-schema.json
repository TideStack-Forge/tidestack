{
  "name": "/dev/{appName}/micro-web/add",
  "schema": {
    "type": "form",
    "title": false,
    "wrapWithPanel": false,
    "mode": "horizontal",
    "api": "/api/dev/${appName}/micro-web",
    "body": [
      {
        "type": "input-text",
        "name": "name",
        "label": "名称",
        "validations": {
          "isVariableName": true
        },
        "required": true
      },
      {
        "type": "list-select",
        "name": "type",
        "label": "类型",
        "options": [
          {
            "label": "微前端应用",
            "value": "app"
          },
          {
            "label": "微前端组件",
            "value": "parcels"
          },
          {
            "label": "AMIS组件库",
            "value": "library"
          }
        ],
        "required": true,
        "value": "page"
      },
      {
        "type": "input-file",
        "name": "packagePath",
        "label": "微前端包",
        "maxLength": 1,
        "drag": true,
        "useChunk": false,
        "accept": ".zip",
        "receiver": "/api/dev/${appName}/micro-web/upload-package",
        "downloadUrl": false
      },
      {
        "type": "input-text",
        "name": "publicPath",
        "label": "微前端部署路径",
        "required": true,
        "visibleOn": "${packagePath}"
      },
      {
        "type": "input-text",
        "name": "entry",
        "label": "微前端入口",
        "requiredOn": "${!packagePath}",
        "disabledOn": "${packagePath}"
      },
      {
        "type": "textarea",
        "name": "description",
        "label": "描述"
      }
    ]
  }
}
