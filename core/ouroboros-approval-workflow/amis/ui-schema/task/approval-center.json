{
  "type": "page",
  "css": {
    ".container": {
      "width": "1620px"
    }
  },
  "data": {},
  "body": [
    {
      "type": "crud",
      "name": "approval-center",
      "syncLocation": false,
      "api": {
        "method": "get",
        "url": "/api/approval-process/my-task"
      },
      "defaultParams": {
        "page": 1,
        "perPage": 15
      },
      "filter": {
        "title": "审批事项筛选",
        "debug": true,
        "body": [
          {
            "type": "group",
            "body": [
              {
                "type": "list-select",
                "name": "status",
                "clearable": true,
                "value": "todo",
                "options": [
                  {
                    "label": "待处理",
                    "value": "todo"
                  },
                  {
                    "label": "已处理",
                    "value": "done"
                  }
                ]
              }
            ]
          }
        ],
        "actions": [
          {
            "type": "reset",
            "label": "重置"
          },
          {
            "type": "submit",
            "level": "primary",
            "label": "查询"
          }
        ]
      },
      "itemActions": [
        {
          "label": "详情",
          "type": "button",
          "actionType": "drawer",
          "drawer": {
            "title": "详情",
            "width": "720px",
            "closeOnOutside": true,
            "body": [
              {
                "type": "service",
                "initFetch": "status == 'todo'",
                "api": {
                  "method": "GET",
                  "url": "/api/approval-process/task/${taskId}",
                  "headers": {
                    "Authorization": "${ls:token}"
                  }
                },
                "showErrorMsg": false,
                "body": [
                  {
                    "type": "card",
                    "header": {
                      "title": "任务名称：${taskName}",
                      "subTitle": "任务类型：${type == null ? '已结束' : type}",
                      "description": "任务发起人ID：${processStarter}"
                    },
                    "media": {
                      "type": "image",
                      "className": "w-30 h-18",
                      "url": "data:image/png;base64,",
                      "position": "left"
                    },
                    "body": "发起时间：${startTime} ${CONCATENATE('    ')} —— 结束时间：${endTime == null ? '正在进行' : endTime}",
                    "toolbar": [
                      {
                        "type": "tag",
                        "label": "审批任务编号：${taskId}",
                        "displayMode": "rounded",
                        "color": "inactive",
                        "className": "w-56"
                      }
                    ]
                  },
                  {
                    "type": "card",
                    "body": {
                      "type": "timeline",
                      "source": {
                        "method": "GET",
                        "url": "/api/approval-process/task/timeline/${taskId}"
                      }
                    }
                  },
                  {
                    "type": "card",
                    "visibleOn": "${status == 'todo'}",
                    "body": [
                      {
                        "type": "form",
                        "title": "审批表单",
                        "wrapWithPanel": false,
                        "debug": true,
                        "body": [
                          {
                            "name": "comment",
                            "type": "textarea",
                            "clearable": true,
                            "showCounter": true,
                            "placeholder": "驳回请求时，请填写驳回理由"
                          },
                          {
                            "type": "card",
                            "visibleOn": "${status == 'todo'}",
                            "body": [
                              {
                                "type": "form",
                                "debug": true,
                                "title": "审批信息",
                                "body": {
                                  "type": "service",
                                  "schemaApi": {
                                    "method": "GET",
                                    "url": "/api/approval-process/task/${taskId}/task-form"
                                  }
                                },
                                "actions": [
                                  {
                                    "visibleOn": "${canEnd == true}",
                                    "type": "action",
                                    "label": "驳回",
                                    "level": "danger",
                                    "actionType": "ajax",
                                    "reload": "approval-center",
                                    "api": {
                                      "method": "POST",
                                      "url": "/api/approval-process/task/${taskId}/submit?approve=false&comment=${comment}&action=end",
                                      "headers": {
                                        "Authorization": "${ls:token}"
                                      }
                                    },
                                    "redirect": "/task/approval-center"
                                  },
                                  {
                                    "visibleOn": "${canRepeat == true}",
                                    "type": "action",
                                    "label": "回退",
                                    "level": "danger",
                                    "actionType": "ajax",
                                    "reload": "approval-center",
                                    "api": {
                                      "method": "POST",
                                      "url": "/api/approval-process/task/${taskId}/submit?approve=false&comment=${comment}&action=repeat"
                                    },
                                    "redirect": "/task/approval-center"
                                  },
                                  {
                                    "visibleOn": "${type == '会签'}",
                                    "type": "action",
                                    "label": "拒绝",
                                    "level": "danger",
                                    "actionType": "ajax",
                                    "reload": "approval-center",
                                    "api": {
                                      "method": "POST",
                                      "url": "/api/approval-process/task/${taskId}/submit?approve=false&comment=${comment}&action=end",
                                      "headers": {
                                        "Authorization": "${ls:token}"
                                      }
                                    },
                                    "redirect": "/task/approval-center"
                                  },
                                  {
                                    "type": "action",
                                    "label": "审核通过",
                                    "level": "primary",
                                    "actionType": "ajax",
                                    "reload": "approval-center",
                                    "api": {
                                      "method": "POST",
                                      "url": "/api/approval-process/task/${taskId}/submit?approve=true"
                                    },
                                    "redirect": "/task/approval-center"
                                  }
                                ]
                              }
                            ]
                          }
                        ],
                        "actions": []
                      }
                    ]
                  }
                ]
              }
            ],
            "actions": []
          }
        }
      ],
      "filterTogglable": true,
      "headerToolbar": [
        "load-more",
        "export-excel",
        "filter-toggler",
        {
          "type": "reload",
          "align": "right",
          "icon": "fa fa-repeat",
          "label": "刷新",
          "tooltip": "",
          "level": "primary"
        }
      ],
      "footerToolbar": [
        "statistics",
        "switch-per-page",
        "pagination"
      ],
      "alwaysShowPagination": true,
      "hideQuickSaveBtn": true,
      "columns": [
        {
          "name": "workflowModel.id",
          "label": "流程 ID"
        },
        {
          "name": "workflowModel.name",
          "label": "流程名称"
        },
        {
          "name": "taskId",
          "label": "任务ID"
        },
        {
          "name": "taskName",
          "label": "任务名称"
        },
        {
          "name": "processStarter",
          "label": "任务发起人 ID"
        },
        {
          "name": "startTime",
          "label": "发起时间"
        },
        {
          "name": "${endTime ? endTime : '正在进行'}",
          "label": "完成时间"
        }
      ]
    }
  ]
}