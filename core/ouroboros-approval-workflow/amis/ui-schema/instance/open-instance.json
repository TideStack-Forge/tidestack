{
  "type": "page",
  "css": {
    ".container": {
      "width": "1620px"
    }
  },
  "body": {
    "type": "service",
    "api": {
      "method": "get",
      "url": "/api/approval-process/available",
      "data": {
        "page": 1,
        "perPage": 1000
      }
    },
    "body": {
      "type": "each",
      "name": "items",
      "items": {
        "type": "cards",
        "title": "<%= data.title %> — <%= data.cards.length %>",
        "source": "${cards}",
        "card": {
          "itemAction": {
            "type": "button",
            "actionType": "link",
            "link": "/instance/instance-form?id=${id}"
          },
          "header": {
            "title": "名称<span class='label label-info m-l-sm'>${name}</span>"
          },
          "media": {
            "type": "image",
            "className": "w-12 h-12",
            "url": "data:image/png;base64,",
            "position": "left"
          },
          "body": "描述：${description}",
          "toolbar": [
            {
              "type": "button",
              "label": "查看",
              "level": "light",
              "actionType": "dialog",
              "dialog": {
                "title": "流程信息",
                "closeOnEsc": true,
                "closeOnOutside": true,
                "actions": [],
                "body": {
                  "type": "property",
                  "mode": "simple",
                  "column": 1,
                  "separator": "：",
                  "items": [
                    {
                      "label": "流程 ID",
                      "content": "${id}"
                    },
                    {
                      "label": "流程部署 ID",
                      "content": "${processDefinitionId}"
                    },
                    {
                      "label": "流程名称",
                      "content": "${name}"
                    },
                    {
                      "label": "流程描述",
                      "content": "${description}"
                    },
                    {
                      "label": "流程分类",
                      "content": "${title}"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}