{
  "name": "/system-setting/approval-workflow-definition/version-detail",
  "schema": {
    "type": "page",
    "body": [
      {
        "type": "service",
        "api": {
          "method": "GET",
          "url": "/api/approval-workflow/definition/${flowKey}/versions/${version}"
        },
        "body": [
          {
            "type": "card",
            "header": {
              "title": "版本信息"
            },
            "body": [
              {
                "type": "property",
                "mode": "simple",
                "column": 2,
                "separator": "：",
                "items": [
                  {
                    "label": "流程标识",
                    "content": "${flowKey}",
                    "span": 1
                  },
                  {
                    "label": "版本号",
                    "content": "${version}",
                    "span": 1
                  },
                  {
                    "label": "流程名称",
                    "content": "${name}",
                    "span": 1
                  },
                  {
                    "label": "部署时间",
                    "content": "${deploymentTime|date:YYYY-MM-DD HH\\:mm\\:ss :YYYY-MM-DDTHH\\:mm\\:ss}",
                    "span": 1
                  },
                  {
                    "label": "流程分类",
                    "content": "${category}",
                    "span": 1
                  },
                  {
                    "label": "状态",
                    "content": "${status == 'active' ? '当前版本' : '历史版本'}",
                    "span": 1
                  },
                  {
                    "label": "流程描述",
                    "content": "${description}",
                    "span": 1
                  }
                ]
              }
            ]
          },
          {
            "type": "card",
            "header": {
              "title": "流程图"
            },
            "body": [
              {
                "type": "workflow-diagram-viewer",
                "definition": "${definition}",
                "height": 600
              }
            ]
          }
        ],
        "dsType": "api"
      }
    ],
    "asideResizor": false,
    "pullRefresh": {
      "disabled": true
    }
  }
}
