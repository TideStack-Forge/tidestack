{
  "name": "/approval-center/start",
  "schema": {
    "type": "page",
    "bodyClassName": "p-0",
    "body": {
      "type": "service",
      "name": "service",
      "api": {
        "method": "get",
        "url": "/api/approval-workflow/instance/available",
        "data": {
          "page": 1,
          "perPage": 1000
        }
      },
      "body": [
        {
          "type": "wrapper",
          "style": {
            "padding": "0",
            "overflow": "hidden"
          },
          "body": {
            "type": "button",
            "label": "刷新",
            "level": "primary",
            "actionType": "reload",
            "icon": "fa fa-repeat",
            "target": "service",
            "className": "float-right"
          }
        },
        {
          "type": "each",
          "name": "items",
          "items": {
            "type": "cards",
            "title": "<%= data.title || '未分类' %> — <%= data.cards.length %>",
            "source": "${cards}",
            "card": {
              "itemAction": {
                "type": "button",
                "actionType": "link",
                "link": "/approval-center/start/init-form?id=${id}"
              },
              "header": {
                "title": "名称<span class='label label-info m-l-sm'>${name}</span>"
              },
              "media": {
                "type": "image",
                "className": "w-12 h-12",
                "url": "data:image/png;base64,",
                "position": "left"
              },
              "body": "描述：${description}",
              "toolbar": [
                {
                  "type": "button",
                  "label": "查看",
                  "level": "light",
                  "actionType": "dialog",
                  "dialog": {
                    "title": "流程信息",
                    "closeOnEsc": true,
                    "closeOnOutside": true,
                    "actions": [
                      {
                        "type": "action",
                        "actionType": "cancel",
                        "label": "关闭"
                      }
                    ],
                    "url": "/approval-center/start/process-detail"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
