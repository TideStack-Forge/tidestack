{
  "name": "/approval-center/free-reject-form",
  "schema": {
    "type": "form",
    "wrapWithPanel": false,
    "title": false,
    "id": "free-reject-form",
    "mode": "normal",
    "initApi": {
      "method": "GET",
      "url": "/api/approval-workflow/task/${id}/free-reject-targets"
    },
    "body": [
      {
        "name": "freeReject.targetNodeId",
        "type": "select",
        "label": "驳回到",
        "required": true,
        "clearable": true,
        "source": "${items|pick:data:label~value}"
      },
      {
        "name": "comment",
        "type": "textarea",
        "clearable": true,
        "showCounter": true,
        "required": true,
        "label": "填写自由驳回理由",
        "placeholder": "自由驳回请求时，请填写驳回理由"
      }
    ],
    "actions": [
      {
        "type": "action",
        "actionType": "cancel",
        "label": "取消"
      },
      {
        "type": "action",
        "actionType": "confirm",
        "level": "primary",
        "label": "确认",
        "onEvent": {
          "click": {
            "actions": [
              {
                "actionType": "validate",
                "componentId": "free-reject-form"
              },
              {
                "actionType": "ajax",
                "api": {
                  "method": "POST",
                  "url": "/api/approval-workflow/task/${id}",
                  "data": {
                    "&": "$$",
                    "action": "freeReject",
                    "formData": "$formData"
                  }
                },
                "expression": "!validateResult.error",
                "outputVar": "submitResponse"
              },
              {
                "actionType": "reload",
                "componentId": "approval-center",
                "expression": "!submitResponse.error"
              },
              {
                "actionType": "closeDrawer",
                "componentId": "drawer-detail",
                "expression": "!submitResponse.error"
              }
            ]
          }
        }
      }
    ]
  }
}
