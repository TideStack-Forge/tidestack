{
  "name": "logicflow",
  "version": "1.0.0",
  "description": "逻辑流图形化编辑器",
  "author": "wangmeili",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs && vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "dev": "webpack serve --config webpack.config.js --mode development",
    "start": "webpack serve --config webpack.config.js --mode development",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.jsx src tests webpack.config.js",
    "build": "webpack --config webpack.config.js --mode production",
    "zip": "node ./scripts/zip-package.cjs dist logicFlowEditor.zip",
    "package": "npm run build && npm run zip",
    "sync": "node ./scripts/sync-package.cjs",
    "package:sync": "npm run package && npm run sync",
    "test:integration:runtime-debug": "playwright test --config tests/integration/logicflow/harness/runtime-debug.playwright.config.cjs",
    "test:integration:runtime-debug-platform": "playwright test --config tests/integration/logicflow/harness/runtime-debug-platform.playwright.config.cjs"
  },
  "dependencies": {
    "@antv/layout": "^0.3.25",
    "@antv/x6": "^2.18.1",
    "@antv/x6-plugin-dnd": "^2.1.1",
    "@antv/x6-plugin-history": "^2.2.4",
    "@antv/x6-plugin-minimap": "^2.0.7",
    "@antv/x6-plugin-scroller": "^2.0.10",
    "@antv/x6-plugin-selection": "^2.2.2",
    "@antv/x6-plugin-snapline": "^2.1.7",
    "@antv/x6-plugin-stencil": "^2.1.5",
    "lodash": "^4.18.1",
    "ouroboros-sdk": "^1.2.4-beta.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.61.1",
    "ajv": "^8.18.0",
    "amis": "^6.13.0",
    "amis-core": "^6.13.0",
    "babel-loader": "^9.2.1",
    "cross-zip": "^4.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.9.2",
    "mobx-react-lite": "^2.2.2",
    "react-is": "^19.2.6",
    "sass": "^1.101.0",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "svg-sprite-loader": "^6.0.11",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
